package layout

import (
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/middleware"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// htmxConfig is the `htmx-config` meta content. htmx 2 swaps 4xx/5xx by
// nothing by default; its native `responseHandling` (the htmx 2 successor
// of the response-targets extension, docs/components/overview.md §4
// "エラー表示") sends those responses' fragment (atoms.Toast, see
// handler.respondActionError) into `#toast-region` instead of the
// request's own target, and still fires `htmx:responseError`.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true,"target":"#toast-region","swapOverride":"beforeend"}]}`

// Shell is the shared full-page HTML document skeleton every
// internal/web/pages component renders into (docs/components/overview.md
// §2, §3). It links the esbuild/Tailwind build output
// (static/src/dist/css/app.css, static/src/dist/js/...) and the vendored
// HTMX runtime (static/src/vendor/htmx.min.js - plain JS, so it does not
// need the esbuild/TypeScript pipeline), both served by
// internal/router.New()'s "/static" static file route. organisms.Header
// (nav + StatusDot + `pitha-kill-switch-panel`) is rendered on every
// page here rather than per-page, since it is "全ページ共通"
// (components/overview.md §3).
templ Shell(title string) {
	@document(title) {
		@organisms.Header(middleware.SystemStateFrom(ctx))
		<main class="mx-auto max-w-6xl px-6 py-8">
			{ children... }
		</main>
	}
}

// SetupShell is Shell without organisms.Header, for the first-run Setup
// screen (issue #80). Setup Guard redirects every route but `/setup`,
// `/static/...` and `/settings/:key` writes while a required secret is
// unset, so Header's `hx-get` fragments (`/system/status`,
// `/system/secrets-status`, ...) and its nav links would all bounce back
// to `/setup` and swap a whole page into `#header-status`.
templ SetupShell(title string) {
	@document(title) {
		<main class="mx-auto max-w-3xl px-6 py-8">
			{ children... }
		</main>
	}
}

templ document(title string) {
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ middleware.CSRFToken(ctx) }/>
			<title>{ title } - pitha-trador</title>
			<meta name="htmx-config" content={ htmxConfig }/>
			<link rel="stylesheet" href="/static/dist/css/app.css"/>
			<script src="/static/vendor/htmx.min.js"></script>
			<script type="module" src="/static/dist/js/kill-switch-panel/pitha-kill-switch-panel.js"></script>
			<script type="module" src="/static/dist/js/htmx-errors/pitha-htmx-errors.js"></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900" hx-headers={ templ.JSONString(map[string]string{middleware.CSRFHeader: middleware.CSRFToken(ctx)}) }>
			{ children... }
			<div id="toast-region" class="pointer-events-none fixed right-4 top-4 z-50 flex w-96 max-w-full flex-col gap-2" aria-live="assertive"></div>
			<template id="toast-template">
				@atoms.Toast("")
			</template>
		</body>
	</html>
}
