package pages

import (
	"time"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// ScannerPage is the Scanner Dashboard full page (functional.md §5.1):
// layout.Shell around organisms.ScanPanel (scan funnel, issue #303) and
// organisms.ScannerTableFallback, plus the
// `pitha-scanner-table` Lit component bundle (components/overview.md
// §5.2) that hydrates over ScannerTableFallback's SSR markup. `GET
// /scanner` (internal/web/handler/scanner.ScannerHandler.Page) always renders
// this full page; it has no HX-Request fragment variant (the only HTMX
// fragment route on this screen is `GET /scanner/scan`).
templ ScannerPage(candidates []domain.Candidate, asOf time.Time, scan organisms.ScanPanelView) {
	@layout.Shell("候補銘柄", organisms.NavScanner) {
		<h1 class="text-2xl font-bold text-slate-900">候補銘柄</h1>
		@molecules.TabNav("候補銘柄のタブ", candidateTabs(tabCandidates))
		@organisms.ScanPanel(scan)
		@organisms.ScannerTableFallback(candidates, asOf)
		<script type="module" src="/static/dist/js/scanner-table/pitha-scanner-table.js"></script>
	}
}
