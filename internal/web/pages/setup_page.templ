package pages

import (
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// SetupProps is SetupPage's input: the connections to offer
// (internal/web/handler/settings.SettingsHandler.SetupPage) - Jev, the
// selected broker's connection and the optional Slack one -, the broker
// selection / 立花 settings groups (Operational, empty without
// OperationalSettings), whether everything required is already stored, and
// the selected broker: Tachibana is true when 立花証券 e支店 is selected (its
// 認証ID and 秘密鍵 path are required instead of KABU_API_PASSWORD, issue
// #734) and Production when its 本番 environment is.
type SetupProps struct {
	Connections []molecules.ConnectionProps
	Operational []molecules.SettingGroupProps
	Complete    bool
	Tachibana   bool
	Production  bool
}

// SetupPage is the first-run Setup screen (issue #80, FR-SETUP-2).
// middleware.SetupGuard redirects every other route here until
// everything the selected broker needs is stored (JEV_API_KEY plus
// KABU_API_PASSWORD, or for 立花 the environment's 認証ID and 秘密鍵 path).
// Since issue #302 it uses
// the same organisms.ConnectionList as Settings - a list of connections,
// each opening a modal of its keys - restricted to Jev, kabuステーション
// and the optional Slack; saving and deleting post to the same `POST`/
// `DELETE /settings/:key` routes. It renders in layout.SetupShell (no
// Header) so nothing on the page fetches a guarded fragment. The "続ける"
// link lives in molecules.SetupStatus and is rendered only once every
// required key is stored (issue #352), so it is never a link the guard would
// send straight back here.
templ SetupPage(props SetupProps) {
	@layout.SetupShell("Setup") {
		<h1 class="text-2xl font-bold text-slate-900">初期セットアップ</h1>
		<div class="mt-4 flex flex-col gap-4" data-testid="setup-form">
			<p class="text-sm text-slate-600">
				if props.Tachibana {
					「必須」と表示された接続先と、立花証券 e支店の秘密鍵ファイルのパスを保存してください。
				} else {
					「必須」と表示された接続先を開いて保存してください。
				}
				保存・削除の反映には再起動が必要です。
				<span data-testid="setup-advanced-note">
					@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-setup-steps", Label: "セットアップの説明"}) {
						if props.Tachibana {
							必須の接続先は、Jev の API キーと、立花証券 e支店の選択中の環境（
							if props.Production {
								本番
							} else {
								デモ
							}
							）の認証ID です。あわせて、「立花証券 e支店（接続設定）」で選択中の環境の秘密鍵ファイルのパスを保存してください。
						} else {
							必須の接続先は、Jev の API キーと kabuステーションの API パスワードです。立花証券 e支店を使う場合は、先に「ブローカー」で立花証券 e支店を選んでください。
						}
						保存済みの値はセキュリティのため画面上に表示されません。接続先 URL やモデル名は未入力で既定値が使われます。Luna・Sol・Opus・ニュースフィードなどの接続先は、セットアップ後に設定画面から追加できます。
					}
				</span>
			</p>
			@organisms.ConnectionList(props.Connections)
			if len(props.Operational) > 0 {
				@organisms.SettingGroupList(props.Operational)
			}
		</div>
		@molecules.SetupStatus(props.Complete, false)
		<script type="module" src="/static/dist/js/modal/pitha-modal.js"></script>
	}
}
