package pages

import "github.com/ousiassllc/pitha-trador/internal/web/layout"

// SettingsField mirrors one secrets-table row the Settings screen
// manages: Key is the DB row key (config.KeyJevAPIKey etc., also used as
// this field's `<input name>`), Label is the human-readable heading, and
// Configured reports whether a value is currently stored. `GET
// /settings` never re-displays the value itself, only whether one
// exists (issue #57's decision).
type SettingsField struct {
	Key        string
	Label      string
	Configured bool
}

// SettingsProps is SettingsPage's input. Saved is true right after a
// successful `POST /settings` (internal/web/handler.SettingsHandler.Save).
type SettingsProps struct {
	Fields []SettingsField
	Saved  bool
}

// SettingsPage is the Settings screen (issue #57 スコープ item 6):
// JEV_API_KEY/JEV_BASE_URL/KABU_API_PASSWORD/SLACK_WEBHOOK_URL input
// form, `POST /settings` (internal/web/handler.SettingsHandler.Save)'d
// back here. Submitting a field blank clears its stored value (see the
// note rendered in the form itself) rather than leaving the existing
// value untouched - internal/repository.SecretsRepository.Set's own doc
// comment records this choice.
templ SettingsPage(props SettingsProps) {
	@layout.Shell("Settings") {
		<h1>Settings</h1>
		if props.Saved {
			<p role="status" data-testid="settings-saved">保存しました。反映にはアプリの再起動が必要です。</p>
		}
		<form method="post" action="/settings" data-testid="settings-form">
			<p>
				空欄のまま保存すると、その項目は未設定に戻ります。既存の値を維持したい場合は同じ値を再入力してください（保存済みの値はセキュリティのため画面上に表示されません）。
			</p>
			for _, field := range props.Fields {
				<label>
					{ field.Label }
					if field.Configured {
						<span data-testid={ "configured-" + field.Key }>(設定済み)</span>
					}
					<input
						type="password"
						name={ field.Key }
						autocomplete="off"
						placeholder={ settingsPlaceholder(field.Configured) }
					/>
				</label>
			}
			<button type="submit">保存</button>
		</form>
	}
}

// settingsPlaceholder hints at each field's current state without ever
// rendering the stored value itself.
func settingsPlaceholder(configured bool) string {
	if configured {
		return "変更する場合のみ入力"
	}
	return "未設定"
}
