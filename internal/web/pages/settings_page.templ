package pages

import (
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// SettingsProps is SettingsPage's input: one molecules.ConnectionProps per
// external service (internal/web/handler/settings.SettingsHandler.Page),
// each carrying all of that service's keys.
type SettingsProps struct {
	Connections []molecules.ConnectionProps
	// Operational are the operator-editable, non-secret settings groups
	// (issue #708); empty hides the section.
	Operational []molecules.SettingGroupProps
}

// SettingsPage is the Settings screen (issue #57 スコープ item 6, issue
// #79, reorganised by issue #302): a list of connections - Jev,
// kabuステーション, Slack, Luna, ニュースフィード, Sol, Opus - each showing
// whether it is configured and opening a modal with all of that
// connection's keys, URL and model name (organisms.ConnectionList), plus a
// システム section whose アップデート and エラーログ entries open the
// UpdatePanel and ErrorLogPanel in modals of their own. Every field keeps
// its own independent save (`POST /settings/:key`) and delete (`DELETE
// /settings/:key`) form (internal/web/handler/settings.SettingsHandler.
// Save/Delete) - a blank or untouched field can never clear another
// field's stored value.
templ SettingsPage(props SettingsProps) {
	@layout.Shell("Settings", organisms.NavSettings) {
		<h1 class="text-2xl font-bold text-slate-900">Settings</h1>
		<div class="mt-4 flex flex-col gap-6" data-testid="settings-form">
			<p class="text-sm text-slate-600">
				接続先を選ぶと、その接続先のキー・URL・モデル名を編集できます。項目ごとに保存・削除できます。保存済みの値はセキュリティのため画面上に表示されません（変更する場合は新しい値を入力して保存してください）。接続先の保存・削除の反映にはアプリの再起動が必要です。
			</p>
			<section class="flex flex-col gap-3" aria-labelledby="settings-connections-heading">
				<h2 id="settings-connections-heading" class="text-lg font-semibold text-slate-900">接続先</h2>
				@organisms.ConnectionList(props.Connections)
			</section>
			if len(props.Operational) > 0 {
				<section class="flex flex-col gap-3" aria-labelledby="settings-operational-heading">
					<h2 id="settings-operational-heading" class="text-lg font-semibold text-slate-900">運用設定</h2>
					<p class="text-sm text-slate-600">
						バックアップ先・ログディレクトリ・Policy Engine / Fast Screener のしきい値を編集できます。優先順位は config/strategy.yaml の値 &lt; ここで保存した値です。項目ごとに保存でき、「既定に戻す」で保存した値を消して既定（strategy.yaml・既定ディレクトリ・無効）に戻せます。反映のタイミング（再起動の要否）は各項目の説明に記載しています。
					</p>
					@organisms.SettingGroupList(props.Operational)
				</section>
			}
			<section class="flex flex-col gap-3" aria-labelledby="settings-system-heading">
				<h2 id="settings-system-heading" class="text-lg font-semibold text-slate-900">システム</h2>
				<ul class="flex flex-col gap-3" data-testid="system-list">
					@molecules.SettingsCard(molecules.SettingsCardProps{
						ID:          "update",
						ModalID:     "modal-update",
						Name:        "アップデート",
						Description: "現在のバージョンと最終確認結果を確認し、新しいバージョンを今すぐ確認できます。",
						ActionLabel: "開く",
					})
					@molecules.SettingsCard(molecules.SettingsCardProps{
						ID:          "error-log",
						ModalID:     "modal-error-log",
						Name:        "エラーログ",
						Description: "調査や共有のために、エラーログをダウンロードできます。",
						ActionLabel: "開く",
					})
				</ul>
			</section>
		</div>
		@molecules.Modal("modal-update", "アップデート") {
			// Header's version link lands here (`/settings#update-panel`):
			// pitha-modal opens the dialog containing the hash target, and
			// `:target` rings the panel once arrived. Filled in by `GET
			// /system/update-panel` (organisms.UpdatePanel) on load and
			// swapped in place by its "今すぐアップデートを確認" button;
			// `empty:hidden` keeps the not-yet-loaded wrapper from showing a
			// bare ring.
			<div id="update-panel" class="scroll-mt-4 rounded-md target:ring-2 target:ring-blue-500 empty:hidden" hx-get="/system/update-panel" hx-trigger="load" hx-target="this" hx-swap="innerHTML"></div>
		}
		@molecules.Modal("modal-error-log", "エラーログ") {
			@organisms.ErrorLogPanel()
		}
		<script type="module" src="/static/dist/js/modal/pitha-modal.js"></script>
	}
}
