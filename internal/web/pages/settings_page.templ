package pages

import (
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// SettingsProps is SettingsPage's input: one SecretFieldRow per managed
// key (internal/web/handler/settings.SettingsHandler.Page).
type SettingsProps struct {
	Fields []molecules.SecretFieldRowProps
}

// SettingsPage is the Settings screen (issue #57 スコープ item 6, issue
// #79): JEV_API_KEY/JEV_BASE_URL/KABU_API_PASSWORD/SLACK_WEBHOOK_URL plus
// the optional LUNA_*/NEWS_FEED_*/SOL_*/OPUS_* AI/News API credentials,
// each as its own molecules.SecretFieldRow with an independent save
// (`POST /settings/:key`) and delete (`DELETE /settings/:key`) form
// (internal/web/handler/settings.SettingsHandler.Save/Delete) - a blank or
// untouched field can never clear another field's stored value.
templ SettingsPage(props SettingsProps) {
	@layout.Shell("Settings") {
		<h1 class="text-2xl font-bold text-slate-900">Settings</h1>
		// Header's version link lands here (`/settings#update-panel`), so it
		// sits right under the title, inside the first screen, instead of
		// below the secret-field rows where the anchor could not scroll it
		// into view; `:target` rings it once arrived. Filled in by `GET
		// /system/update-panel` (organisms.UpdatePanel) on load and swapped
		// in place by its "今すぐアップデートを確認" button; `empty:hidden`
		// keeps the not-yet-loaded wrapper from showing a bare ring.
		<div id="update-panel" class="mt-4 scroll-mt-4 rounded-md target:ring-2 target:ring-blue-500 empty:hidden" hx-get="/system/update-panel" hx-trigger="load" hx-target="this" hx-swap="innerHTML"></div>
		<div class="mt-4 flex flex-col gap-4" data-testid="settings-form">
			<p class="text-sm text-slate-600">
				項目ごとに保存・削除できます。保存済みの値はセキュリティのため画面上に表示されません（変更する場合は新しい値を入力して保存してください）。保存・削除の反映にはアプリの再起動が必要です。
			</p>
			for _, field := range props.Fields {
				@molecules.SecretFieldRow(field)
			}
		</div>
		@organisms.ErrorLogPanel()
	}
}
