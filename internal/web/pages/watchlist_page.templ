package pages

import (
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// WatchlistPage is the Watchlist full page (issue #730, child of #726): the
// 立花 監視リスト decided after each close - which 立会日 it is for, how it was
// decided (日足スクリーニング / 固定リスト / 日足を使えず引き継ぎ・切り替え) and,
// per symbol, whether it holds a fixed slot (保有・注文中), was named by the
// operator or was selected by which screening indicators. The list in use now
// is marked. `GET /watchlist` (internal/web/handler/watchlist.Handler)
// renders it; it is server-rendered only (no island).
templ WatchlistPage(view domain.WatchListView) {
	@layout.Shell("監視リスト", organisms.NavScanner) {
		<h1 class="text-title font-bold text-ink">
			監視リスト
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-watchlist", Label: "監視リストの説明"}) {
				立花証券の監視銘柄は、引け後の日足スクリーニング（または固定リスト）で翌営業日分が前夜に確定し、翌朝のEVENT購読に使われます。
			}
		</h1>
		<p class="mt-2 text-item text-ink">
			設定は
			<a class="text-accent underline decoration-mute" href="/settings/broker">設定 ＞ 証券会社・データ</a>
			で変更できます。
		</p>
		@molecules.TabNav("候補銘柄のタブ", candidateTabs(tabWatchlist))
		if !view.Enabled {
			<p class="mt-6 rounded-card bg-surface px-4 py-3 text-item text-ink" data-testid="watchlist-disabled">
				監視リストは立花証券を選択しているときだけ確定されます。
				@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-watchlist-disabled", Label: "監視リストが使われない場合の説明"}) {
					kabuステーションを選択しているときは、監視リストの代わりにランキング監視（/ranking）を使います。
				}
			</p>
		} else if len(view.Lists) == 0 {
			<p class="mt-6 rounded-card bg-surface-sel px-6 py-12 text-center text-item text-mute-on-soft" data-testid="watchlist-empty">
				確定済みの監視リストはありません。最初の夜間バッチ（日足取得）の後に作られます。
			</p>
		}
		for _, list := range view.Lists {
			@watchlistSection(list, list.ListDate == view.ActiveDate)
		}
	}
}

templ watchlistSection(list domain.WatchList, active bool) {
	<section class="mt-12" data-testid="watchlist" data-list-date={ list.ListDate } data-source={ list.Source } data-active={ strconv.FormatBool(active) }>
		<h2 class="mb-4 text-item font-semibold text-ink">
			{ list.ListDate } の監視リスト
			if active {
				<span class="ml-2 rounded-pill tone-success px-3 py-1 text-note" data-testid="watchlist-active">使用中</span>
			}
			if list.Fallback() {
				<span class="ml-2 rounded-pill tone-warning px-3 py-1 text-note" data-testid="watchlist-fallback">代替リスト</span>
			}
		</h2>
		<dl class="grid gap-x-4 gap-y-1 text-ink sm:grid-cols-[max-content_1fr]">
			<dt class="text-note text-mute">確定方法</dt>
			<dd class="text-item">{ label(watchSourceLabels, list.Source) }</dd>
			if list.BasisDate != "" {
				<dt class="text-note text-mute">基準日（日足）</dt>
				<dd class="text-item">{ list.BasisDate }</dd>
			}
			<dt class="text-note text-mute">確定時刻</dt>
			<dd class="text-item">{ atoms.FormatJST(list.DecidedAt) }</dd>
			<dt class="text-note text-mute">内容</dt>
			<dd class="text-item">{ list.Reason }</dd>
			<dt class="text-note text-mute">銘柄数</dt>
			<dd class="text-item">{ strconv.Itoa(len(list.Entries)) } 件</dd>
		</dl>
		<table class="mt-3 w-full text-left text-item">
			<caption class="sr-only">{ list.ListDate } の監視銘柄一覧</caption>
			<thead class="text-note text-mute">
				<tr>
					<th scope="col" class="px-3 py-2.5 text-right font-normal">順</th>
					<th scope="col" class="px-3 py-2.5 font-normal">銘柄</th>
					<th scope="col" class="px-3 py-2.5 font-normal">枠の由来</th>
					<th scope="col" class="px-3 py-2.5 font-normal">選ばれた指標</th>
				</tr>
			</thead>
			<tbody>
				for i, e := range list.Entries {
					<tr class="border-b border-line-soft last:border-b-0" data-testid="watchlist-row" data-symbol={ e.Symbol } data-origin={ e.Origin }>
						<td class="px-3 py-2.5 text-right font-mono tabular-nums text-mute">{ strconv.Itoa(i + 1) }</td>
						<td class="px-3 py-2.5 font-mono">
							<a class="text-accent underline decoration-mute" href={ templ.URL("/symbols/" + e.Symbol) }>{ e.Symbol }</a>
						</td>
						<td class="px-3 py-2.5">{ label(watchOriginLabels, e.Origin) }</td>
						<td class="px-3 py-2.5">{ indicatorsText(e.Indicators) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}
