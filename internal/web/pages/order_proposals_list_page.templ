package pages

import (
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// OrderProposalsPage is the AIの注文提案 list (issue #829, child of #826): the
// Paper order proposals the MCP client made, newest first, with their status,
// the reason code, the loss the proposer expected next to the application's
// estimate, and the realized pnl once the position closed. `GET
// /order-proposals` (internal/web/handler/orderproposals) renders it. It only
// reads: a proposal is made, changed and cancelled through the MCP.
templ OrderProposalsPage(props ProposalListProps) {
	@layout.Shell("AIの注文提案", organisms.NavOrderProposals) {
		<h1 class="text-2xl font-bold text-slate-900">AIの注文提案</h1>
		<p class="mt-1 text-sm text-slate-600">
			MCP から出された Paper の注文提案の一覧です。提案の受け付け・取消は MCP 経由で行い、この画面は読むだけです。各提案の詳細（理由・損切りの計画・最大損失・情報源・状態の履歴・ひも付いた注文とポジション）は ID のリンクから開けます。
		</p>
		for _, e := range props.Errors {
			<p class="mt-3 rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-800" role="alert" data-testid="order-proposals-error">{ e }</p>
		}
		<form method="get" action="/order-proposals" class="mt-4 flex flex-wrap items-end gap-3 text-sm" data-testid="order-proposals-filter">
			<label class="flex flex-col gap-1 font-medium text-slate-700">
				開始日（JST）
				<input type="date" name="from" value={ props.Filter.From } class="rounded border border-slate-300 px-2 py-1 font-normal"/>
			</label>
			<label class="flex flex-col gap-1 font-medium text-slate-700">
				終了日（JST）
				<input type="date" name="to" value={ props.Filter.To } class="rounded border border-slate-300 px-2 py-1 font-normal"/>
			</label>
			<label class="flex flex-col gap-1 font-medium text-slate-700">
				状態
				<select name="status" class="rounded border border-slate-300 px-2 py-1 font-normal">
					<option value="">すべて</option>
					for _, o := range props.Statuses {
						<option value={ o.Value } selected?={ o.Value == props.Filter.Status }>{ o.Label }</option>
					}
				</select>
			</label>
			<label class="flex flex-col gap-1 font-medium text-slate-700">
				枠
				<select name="bucket" class="rounded border border-slate-300 px-2 py-1 font-normal">
					<option value="">すべて</option>
					for _, o := range props.Buckets {
						<option value={ o.Value } selected?={ o.Value == props.Filter.Bucket }>{ o.Label }</option>
					}
				</select>
			</label>
			<button type="submit" class="rounded bg-slate-800 px-3 py-1.5 font-semibold text-white hover:bg-slate-700">絞り込む</button>
		</form>
		if props.LoadError != "" {
			<p class="mt-6 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert" data-testid="order-proposals-load-error">{ props.LoadError }</p>
		} else if len(props.Rows) == 0 {
			<p class="mt-6 rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-testid="order-proposals-empty">
				この条件の注文提案はありません。
			</p>
		} else {
			@orderProposalsTable(props.Rows)
			if props.NextHref != "" {
				<p class="mt-3 text-sm"><a class="font-semibold underline" href={ templ.SafeURL(props.NextHref) } data-testid="order-proposals-next">次のページ</a></p>
			}
		}
	}
}

templ orderProposalsTable(rows []ProposalRow) {
	<table class="mt-4 w-full text-left text-sm" data-testid="order-proposals-table">
		<caption class="sr-only">注文提案の一覧（新しい順）</caption>
		<thead class="border-b border-slate-300 text-xs text-slate-600">
			<tr>
				<th scope="col" class="py-1 pr-3" title="ID">注文案番号</th>
				<th scope="col" class="py-1 pr-3">受付（JST）</th>
				<th scope="col" class="py-1 pr-3">銘柄</th>
				<th scope="col" class="py-1 pr-3">枠</th>
				<th scope="col" class="py-1 pr-3">売買</th>
				<th scope="col" class="py-1 pr-3">状態</th>
				<th scope="col" class="py-1 pr-3">数量（提案 → 適用）</th>
				<th scope="col" class="py-1 pr-3">最大損失（提案 / 見積り）</th>
				<th scope="col" class="py-1">実現損益</th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				<tr class="border-b border-slate-100" data-testid="order-proposal-row" data-proposal-id={ strconv.FormatInt(r.ID, 10) } data-status={ r.Status }>
					<td class="py-1 pr-3 font-mono">
						<a class="underline" href={ templ.SafeURL("/order-proposals/" + strconv.FormatInt(r.ID, 10)) }>{ strconv.FormatInt(r.ID, 10) }</a>
					</td>
					<td class="py-1 pr-3">{ r.ReceivedAt }</td>
					<td class="py-1 pr-3 font-mono">
						<a class="underline" href={ organisms.SymbolHref(r.Symbol) }>{ r.Symbol }</a>
					</td>
					<td class="py-1 pr-3">{ label(proposalBucketLabels, r.Bucket) }</td>
					<td class="py-1 pr-3">{ label(proposalActionLabels, r.Action) }</td>
					<td class="py-1 pr-3">
						{ label(proposalStatusLabels, r.Status) }
						<span class="font-mono text-xs text-slate-500">{ r.Status }</span>
						if r.StatusReason != "" {
							<span class="block font-mono text-xs text-slate-500">{ r.StatusReason }</span>
						}
					</td>
					<td class="py-1 pr-3">{ dash(r.Quantity) }</td>
					<td class="py-1 pr-3">{ dash(r.MaxLoss) } / { dash(r.EstimatedLoss) }</td>
					<td class={ pnlClass(r.PnlSign) }>{ dash(r.RealizedPnl) }</td>
				</tr>
			}
		</tbody>
	</table>
}
