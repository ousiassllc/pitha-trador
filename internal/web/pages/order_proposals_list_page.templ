package pages

import (
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// OrderProposalsPage is the AIの注文提案 list: the Paper order proposals the
// MCP client made, newest first, with their status, the reason code, the loss
// the proposer expected next to the application's estimate, and the realized
// pnl once the position closed. `GET /order-proposals`
// (internal/web/handler/orderproposals) renders it. It only reads: a proposal
// is made, changed and cancelled through the MCP.
templ OrderProposalsPage(props ProposalListProps) {
	@layout.Shell("AIの注文提案", organisms.NavOrderProposals) {
		<h1 class="text-3xl font-semibold text-ink">AIの注文提案</h1>
		<p class="mt-1 text-sm text-mute">
			Paper の注文提案
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-order-proposals-about", Label: "AIの注文提案の説明"}) {
				MCP から出された Paper の注文提案の一覧です。提案の受け付け・取消は MCP 経由で行い、この画面は読むだけです。各提案の詳細（理由・損切りの計画・最大損失・情報源・状態の履歴・ひも付いた注文とポジション）は番号のリンクから開けます。
			}
		</p>
		for _, e := range props.Errors {
			<p class="mt-3 rounded-md border tone-danger px-4 py-2 text-sm" role="alert" data-testid="order-proposals-error">{ e }</p>
		}
		<form method="get" action="/order-proposals" class="mt-4 flex flex-wrap items-end gap-3 text-sm" data-testid="order-proposals-filter">
			<label class="flex flex-col gap-2 text-ink">
				開始日（JST）
				@atoms.Input(atoms.InputProps{Name: "from", Type: "date", Class: "px-3 py-2 font-normal", Attrs: templ.Attributes{"value": props.Filter.From}})
			</label>
			<label class="flex flex-col gap-2 text-ink">
				終了日（JST）
				@atoms.Input(atoms.InputProps{Name: "to", Type: "date", Class: "px-3 py-2 font-normal", Attrs: templ.Attributes{"value": props.Filter.To}})
			</label>
			<label class="flex flex-col gap-2 text-ink">
				状態
				@atoms.Select(atoms.SelectProps{Name: "status", Class: "px-3 py-2 font-normal"}) {
					<option value="">すべて</option>
					for _, o := range props.Statuses {
						<option value={ o.Value } selected?={ o.Value == props.Filter.Status }>{ o.Label }</option>
					}
				}
			</label>
			<label class="flex flex-col gap-2 text-ink">
				枠
				@atoms.Select(atoms.SelectProps{Name: "bucket", Class: "px-3 py-2 font-normal"}) {
					<option value="">すべて</option>
					for _, o := range props.Buckets {
						<option value={ o.Value } selected?={ o.Value == props.Filter.Bucket }>{ o.Label }</option>
					}
				}
			</label>
			@atoms.Button(atoms.ButtonProps{Type: "submit", Variant: atoms.ButtonSecondary, Attrs: templ.Attributes{"data-testid": "order-proposals-filter"}}) {
				絞り込む
			}
		</form>
		if props.LoadError != "" {
			<p class="mt-6 rounded-md border tone-danger px-4 py-3 text-sm" role="alert" data-testid="order-proposals-load-error">{ props.LoadError }</p>
		} else if len(props.Rows) == 0 {
			<p class="mt-6 rounded-lg border border-dashed border-border px-6 py-12 text-center text-sm text-mute" data-testid="order-proposals-empty">
				この条件の注文提案はありません。
			</p>
		} else {
			@orderProposalsTable(props.Rows)
			if props.NextHref != "" {
				<p class="mt-3">
					@atoms.ButtonLink(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Attrs: templ.Attributes{"href": string(templ.URL(props.NextHref)), "data-testid": "order-proposals-next"}}) {
						次のページ
					}
				</p>
			}
		}
	}
}

templ orderProposalsTable(rows []ProposalRow) {
	<table class="mt-4 w-full text-left text-sm" data-testid="order-proposals-table">
		<caption class="sr-only">注文提案の一覧（新しい順）</caption>
		<thead class="border-b border-border text-xs text-mute">
			<tr>
				<th scope="col" class="px-3 py-2.5">注文案番号</th>
				<th scope="col" class="px-3 py-2.5">受付（JST）</th>
				<th scope="col" class="px-3 py-2.5">銘柄</th>
				<th scope="col" class="px-3 py-2.5">枠</th>
				<th scope="col" class="px-3 py-2.5">売買</th>
				<th scope="col" class="px-3 py-2.5">状態</th>
				<th scope="col" class="px-3 py-2.5 text-right">
					数量（提案 → 適用）
					@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-order-proposals-quantity", Label: "数量の説明"}) {
						提案された数量と、アプリが決めた数量です。予算で提案された場合は、提案の欄に予算額を表示します。
					}
				</th>
				<th scope="col" class="px-3 py-2.5 text-right">
					最大損失（提案 / 見積り）
					@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-order-proposals-max-loss", Label: "最大損失の説明"}) {
						提案が見込んだ最大損失と、アプリが「数量 ×（約定見込み価格 − 損切り価格）」で見積もった最大損失です。
					}
				</th>
				<th scope="col" class="px-3 py-2.5 text-right">実現損益</th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				<tr class="border-b border-border" data-testid="order-proposal-row" data-proposal-id={ strconv.FormatInt(r.ID, 10) } data-status={ r.Status }>
					<td class="px-3 py-2.5 font-mono">
						<a class="underline decoration-mute" href={ templ.SafeURL("/order-proposals/" + strconv.FormatInt(r.ID, 10)) }>{ strconv.FormatInt(r.ID, 10) }</a>
					</td>
					<td class="px-3 py-2.5">{ r.ReceivedAt }</td>
					<td class="px-3 py-2.5 font-mono">
						<a class="underline decoration-mute" href={ organisms.SymbolHref(r.Symbol) }>{ r.Symbol }</a>
					</td>
					<td class="px-3 py-2.5">{ label(proposalBucketLabels, r.Bucket) }</td>
					<td class="px-3 py-2.5">{ label(proposalActionLabels, r.Action) }</td>
					<td class="px-3 py-2.5">
						{ label(proposalStatusLabels, r.Status) }
						if r.StatusReason != "" {
							<span class="block text-xs text-mute">{ r.StatusReason }</span>
						}
					</td>
					<td class="px-3 py-2.5 text-right font-mono tabular-nums">{ dash(r.Quantity) }</td>
					<td class="px-3 py-2.5 text-right font-mono tabular-nums">{ dash(r.MaxLoss) } / { dash(r.EstimatedLoss) }</td>
					<td class={ pnlClass(r.PnlSign) }>{ dash(r.RealizedPnl) }</td>
				</tr>
			}
		</tbody>
	</table>
}
