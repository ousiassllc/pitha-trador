package pages

import (
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/labels"
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// OrderProposalDetailPage is one 注文提案 in full: what the MCP client
// proposed and why (rationale, the plan for the stop and the exit, the loss it
// expected, its sources), what the application did with it (the timeline of
// states) and what became of it (the linked signal, order and position with the
// realized pnl), so the plan can be checked against the outcome. Every free text
// (rationale, exit plan, a source's title and URL, an event's detail) is escaped
// by Templ and shown as text; a source URL becomes a link only when the handler
// judged it http or https, and then it opens with rel="noopener noreferrer".
// `GET /order-proposals/:id` (internal/web/handler/orderproposals) renders it;
// it has no buttons.
templ OrderProposalDetailPage(p ProposalDetailProps) {
	@layout.Shell(labels.Numbered("注文提案", p.ID), organisms.NavOrderProposals) {
		<p class="text-sm"><a class="underline decoration-mute" href="/order-proposals">@atoms.IconNavArrowLeft() 注文提案の一覧</a></p>
		<h1 class="mt-2 text-3xl font-semibold text-ink" data-testid="order-proposal-title">
			{ labels.Numbered("注文提案", p.ID) }
			<span class="ml-2 font-mono text-lg">
				<a class="underline decoration-mute" href={ organisms.SymbolHref(p.Symbol) }>{ p.Symbol }</a>
			</span>
		</h1>
		<p class="mt-2 text-sm text-ink" data-testid="order-proposal-status" data-status={ p.Status }>
			{ label(proposalActionLabels, p.Action) }・{ label(proposalBucketLabels, p.Bucket) }・{ p.OrderType } ／ 状態:
			<span class="text-ink">{ label(proposalStatusLabels, p.Status) }</span>
			if p.StatusReason != "" {
				<span class="text-xs text-mute">（理由: { p.StatusReason }）</span>
			}
		</p>
		@proposalFields("概要", "order-proposal-summary", "help-order-proposal-summary", p.Summary)
		<section class="mt-12" data-testid="order-proposal-rationale">
			<h2 class="text-xl font-semibold text-ink">理由</h2>
			<p class="mt-2 whitespace-pre-wrap break-words text-sm text-ink">{ p.Rationale }</p>
		</section>
		<section class="mt-12" data-testid="order-proposal-exit-plan">
			<h2 class="text-xl font-semibold text-ink">手じまいの計画</h2>
			if p.ExitPlan == "" {
				<p class="mt-2 text-sm text-mute">—</p>
			} else {
				<p class="mt-2 whitespace-pre-wrap break-words text-sm text-ink">{ p.ExitPlan }</p>
			}
		</section>
		@proposalFields("損切り・利確", "order-proposal-plan", "help-order-proposal-plan", p.Plan)
		@proposalFields("最大損失", "order-proposal-loss", "help-order-proposal-loss", p.Loss)
		@proposalSources(p.Sources)
		@proposalEvents(p.Events)
		for i, l := range p.Linked {
			@proposalFields(l.Title, "order-proposal-linked", "help-order-proposal-linked-"+strconv.Itoa(i), l.Fields)
		}
	}
}

// proposalFields renders a titled label/value list. A field with Help gets a
// HelpMark next to its label; helpPrefix keeps those ids unique on the page.
templ proposalFields(title, testID, helpPrefix string, fields []ProposalField) {
	<section class="mt-12" data-testid={ testID }>
		<h2 class="text-xl font-semibold text-ink">{ title }</h2>
		<dl class="mt-2 grid gap-x-4 gap-y-1 text-sm text-ink sm:grid-cols-[max-content_1fr]">
			for i, f := range fields {
				<dt class="">
					{ f.Label }
					if f.Help != "" {
						@atoms.HelpMark(atoms.HelpMarkProps{ID: helpPrefix + "-" + strconv.Itoa(i), Label: f.Label + "の説明"}) {
							{ f.Help }
						}
					}
				</dt>
				<dd class={ "font-mono tabular-nums", pnlTextClass(f.Sign) }>{ dash(f.Value) }</dd>
			}
		</dl>
	</section>
}

templ proposalSources(sources []ProposalSource) {
	<section class="mt-12" data-testid="order-proposal-sources">
		<h2 class="text-xl font-semibold text-ink">情報源</h2>
		if len(sources) == 0 {
			<p class="mt-2 text-sm text-mute">—</p>
		} else {
			<ul class="mt-2 list-disc space-y-1 pl-6 text-sm text-ink">
				for _, s := range sources {
					<li data-testid="order-proposal-source">
						<span class="break-words">{ s.Title }</span>
						<span class="text-xs text-mute">（取得 { s.RetrievedAt }）</span>
						<br/>
						if s.Href != "" {
							<a class="break-all underline decoration-mute" href={ templ.SafeURL(s.Href) } target="_blank" rel="noopener noreferrer">{ s.URL }</a>
						} else {
							<span class="break-all font-mono text-xs">{ s.URL }</span>
						}
					</li>
				}
			</ul>
		}
	</section>
}

templ proposalEvents(events []ProposalEvent) {
	<section class="mt-12" data-testid="order-proposal-events">
		<h2 class="text-xl font-semibold text-ink">状態の時系列</h2>
		<table class="mt-2 w-full text-left text-sm">
			<caption class="sr-only">状態の変化の履歴（古い順）</caption>
			<thead class="border-b border-border text-xs text-mute">
				<tr>
					<th scope="col" class="px-3 py-2.5">時刻（JST）</th>
					<th scope="col" class="px-3 py-2.5">変化</th>
					<th scope="col" class="px-3 py-2.5">理由</th>
					<th scope="col" class="px-3 py-2.5">主体</th>
					<th scope="col" class="px-3 py-2.5">補足</th>
				</tr>
			</thead>
			<tbody>
				for _, e := range events {
					<tr class="border-b border-border" data-testid="order-proposal-event">
						<td class="px-3 py-2.5">{ e.At }</td>
						<td class="px-3 py-2.5">{ dash(e.From) } → { e.To }</td>
						<td class="px-3 py-2.5">{ dash(e.Reason) }</td>
						<td class="px-3 py-2.5">{ e.Actor }</td>
						<td class="px-3 py-2.5">{ dash(e.Detail) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}
