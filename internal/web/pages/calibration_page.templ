package pages

import "github.com/ousiassllc/pitha-trador/internal/web/layout"

// CalibrationPage is the Calibration full page (functional.md §5.4):
// layout.Shell around the `pitha-calibration-heatmap` island
// (docs/components/overview.md §5.3). Unlike ScannerPage, there is no
// server-rendered fallback content - like SymbolDetailPage's `pitha-
// price-chart`, a canvas-drawn reliability curve has nothing meaningful
// to show before JS/Lit loads - and unlike SymbolDetailPage's per-symbol
// `candles-url`/`ws-url`, `pitha-calibration-heatmap` needs no per-page
// attributes: it defaults its own `calibration-url` to
// `GET /api/v1/calibration` and fetches it directly (no WebSocket,
// components/overview.md §5.3 "リアルタイム性は不要"). `GET /calibration`
// (internal/web/handler.CalibrationHandler.Page) renders this for every
// request.
templ CalibrationPage() {
	@layout.Shell("Calibration") {
		<h1 class="text-2xl font-bold text-slate-900">Calibration</h1>
		<pitha-calibration-heatmap></pitha-calibration-heatmap>
		<script type="module" src="/static/dist/js/calibration-heatmap/pitha-calibration-heatmap.js"></script>
	}
}
