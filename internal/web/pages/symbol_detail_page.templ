package pages

import (
	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// SymbolDetailProps is SymbolDetailPage's input (docs/components/
// overview.md §3's "複雑なコンポーネントはProps構造体" convention -
// SymbolDetailPage has more parameters than a direct-parameter signature
// stays readable with).
type SymbolDetailProps struct {
	Symbol string
	// Position is the symbol's currently open position, or nil
	// (internal/web/handler/symbol maps execution.SymbolState.Position
	// onto it, so pages stay decoupled from internal/service).
	Position *domain.Position
	// Risk is the symbol's risk figures for the "Risk" panel
	// (internal/web/handler/symbol maps its SymbolRiskParams onto it).
	Risk organisms.RiskParams
	// LatestTrader is the symbol's latest Jev Trader decision for the
	// "Jev判定" panel (execution.SymbolState.LatestTraderDecision: no
	// row-count window or age limit, the same definition as the Scanner),
	// or nil when Jev Trader has not evaluated it yet. It is independent of
	// Decisions, which is only the bounded history list.
	LatestTrader *domain.JevDecision
	// Decisions is the symbol's recent Jev Scout/Trader decision history,
	// most recent first (execution.Engine.RecentDecisions), shown in the
	// page's "Decision history" section only.
	Decisions []domain.JevDecision
}

// SymbolDetailPage is the Symbol Detail full page (functional.md §5.2):
// layout.Shell around the price/Jev/Risk/position panels and Decision
// history, plus the `pitha-price-chart` island
// (docs/components/overview.md §5.1) that live-updates over
// `/ws/symbols/{symbol}`. `GET /symbols/:symbol`
// (internal/web/handler/symbol.SymbolHandler.Page) renders this for a normal
// navigation.
templ SymbolDetailPage(props SymbolDetailProps) {
	@layout.Shell(props.Symbol, organisms.NavScanner) {
		<h1 class="text-2xl font-bold text-slate-900">{ props.Symbol }</h1>
		<pitha-price-chart
			candles-url={ symbolCandlesURL(props.Symbol) }
			ws-url={ symbolWSURL(props.Symbol) }
		></pitha-price-chart>
		<script type="module" src="/static/dist/js/price-chart/pitha-price-chart.js"></script>

		@organisms.JevPanel(props.LatestTrader)
		@organisms.RiskPanel(props.Risk)
		@organisms.PositionPanel(props.Position)
		@organisms.DecisionHistoryList(props.Decisions)
	}
}

// symbolCandlesURL is the `GET /api/v1/symbols/{symbol}/candles` URL
// handed to pitha-price-chart; the symbol is escaped by the same rule as
// organisms.SymbolHref.
func symbolCandlesURL(symbol string) string {
	return "/api/v1/symbols/" + organisms.EscapeSymbolSegment(symbol) + "/candles"
}

// symbolWSURL is the `/ws/symbols/{symbol}` URL handed to pitha-price-chart.
func symbolWSURL(symbol string) string {
	return "/ws/symbols/" + organisms.EscapeSymbolSegment(symbol)
}
