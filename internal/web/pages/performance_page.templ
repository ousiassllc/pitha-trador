package pages

import (
	"fmt"
	"time"

	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// PerformanceFold is one Walk Forward fold's Forward period and metrics.
// ForwardEnd is the exclusive end of the day-granular period.
type PerformanceFold struct {
	ForwardStart time.Time
	ForwardEnd   time.Time
	Forward      organisms.PerformanceSummary
}

// PerformanceResult is a Walk Forward backtest's output: the out-of-sample
// metrics Combined across every fold's Forward period, and each Fold.
type PerformanceResult struct {
	Combined organisms.PerformanceSummary
	Folds    []PerformanceFold
}

// PerformanceProps is PerformancePage's input. Actuals is the realized
// (Paper) performance of every closed position, or ActualsError when it
// could not be read. Result is nil until a backtest has been run; Error
// carries a validation or run failure. internal/web/handler maps the
// internal/service types onto these plain props.
type PerformanceProps struct {
	Form         organisms.BacktestFormValues
	Actuals      organisms.PerformanceActuals
	ActualsError string
	Result       *PerformanceResult
	Error        string
}

// PerformancePage is the Performance full page (functional.md §5.3,
// UC-9/UC-12): the realized (Paper) performance of closed positions, a Walk Forward backtest (FR-BT-2) request form over the
// recorded market_snapshots/jev_decisions history, and - once run - the
// out-of-sample Combined Forward metrics plus each fold's Forward
// metrics (FR-BT-1). `GET /performance`
// (internal/web/handler/performance.PerformanceHandler.Page) renders it.
templ PerformancePage(props PerformanceProps) {
	@layout.Shell("Performance") {
		<h1 class="text-2xl font-bold text-slate-900">Performance</h1>
		@organisms.PerformanceActualsPanel(props.Actuals, props.ActualsError)
		@organisms.BacktestForm(props.Form)
		if props.Error != "" {
			<p class="mt-4 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert" data-testid="backtest-error">{ props.Error }</p>
		}
		if props.Result != nil {
			@organisms.PerformanceSummaryPanel("Walk Forward (Forward periods combined)", props.Result.Combined)
			@foldTable(props.Result.Folds)
		}
	}
}

templ foldTable(folds []PerformanceFold) {
	<section class="mb-6 rounded-lg border border-slate-200 bg-white p-6 shadow" data-testid="backtest-folds">
		<h2 class="text-lg font-semibold text-slate-900">Folds</h2>
		<table class="mt-4 w-full border-collapse text-left text-sm" aria-label="Walk Forward 結果（フォールド別）">
			<thead>
				<tr class="border-b border-slate-200 text-xs font-semibold uppercase text-slate-500">
					<th scope="col" class="px-3 py-2">Forward period</th>
					<th scope="col" class="px-3 py-2">Trades</th>
					<th scope="col" class="px-3 py-2">Win Rate</th>
					<th scope="col" class="px-3 py-2">Expectancy</th>
					<th scope="col" class="px-3 py-2">Max Drawdown</th>
					<th scope="col" class="px-3 py-2">Net PnL</th>
				</tr>
			</thead>
			<tbody>
				for _, f := range folds {
					<tr class="border-b border-slate-100">
						<td class="px-3 py-2">{ f.ForwardStart.Format("2006-01-02") } – { lastDay(f.ForwardEnd) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%d", f.Forward.TradeCount) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.1f%%", f.Forward.WinRate*100) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.2f%%", f.Forward.Expectancy) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.2f%%", f.Forward.MaxDrawdownPct) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.2f%%", f.Forward.NetPnLPct) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

// lastDay renders the final (inclusive) day of a day-granular period whose
// exclusive end is end.
func lastDay(end time.Time) string {
	return end.Add(-time.Nanosecond).Format("2006-01-02")
}
