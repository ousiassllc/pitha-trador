package pages

import (
	"github.com/ousiassllc/pitha-trador/internal/web/adminhub"
	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// AdminPage is the admin hub (`GET /admin`, issue #793): every admin screen
// and Settings dialog listed by category with what it does, so none has to
// be found by remembering which screen holds it
// (internal/web/handler/admin.Handler.Page renders it).
templ AdminPage(sections []adminhub.Section) {
	@layout.Shell("管理", organisms.NavAdmin) {
		<h1 class="text-2xl font-bold text-slate-900">管理</h1>
		@organisms.AdminHub(sections)
	}
}
