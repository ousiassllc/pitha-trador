package pages

import (
	"net/http"
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/web/layout"
	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// errorHeading is the page title and heading: the numeric status followed by
// a Japanese name for it (http.StatusText is English).
func errorHeading(status int) string {
	name, ok := statusNames[status]
	if !ok {
		name = "エラー"
	}
	return strconv.Itoa(status) + " " + name
}

var statusNames = map[int]string{
	http.StatusBadRequest:          "リクエストが正しくありません",
	http.StatusUnauthorized:        "認証が必要です",
	http.StatusForbidden:           "アクセスできません",
	http.StatusNotFound:            "ページが見つかりません",
	http.StatusMethodNotAllowed:    "この操作は使えません",
	http.StatusConflict:            "状態が競合しています",
	http.StatusTooManyRequests:     "リクエストが多すぎます",
	http.StatusInternalServerError: "サーバーでエラーが発生しました",
	http.StatusBadGateway:          "外部サービスとの通信に失敗しました",
	http.StatusServiceUnavailable:  "ただいま利用できません",
}

// ErrorPage is the full-page error screen SSR handlers render instead of an
// empty-bodied status (issue #143): layout.Shell (Header included) around
// the status code and a fixed, user-facing message. message MUST be a
// fixed string, never err.Error() - internal detail (SQL, paths) belongs in
// the slog line, not on screen.
templ ErrorPage(status int, message string) {
	@layout.Shell(errorHeading(status), organisms.NavNone) {
		<section class="flex flex-col gap-3" data-testid="error-page">
			<h1 class="text-2xl font-bold text-slate-900">{ errorHeading(status) }</h1>
			<p class="text-sm text-slate-700" role="alert">{ message }</p>
			<p><a class="text-sm text-blue-700 underline" href="/scanner">候補銘柄に戻る</a></p>
		</section>
	}
}
