package atoms

import "strings"

// fieldBase is the border/shape/ground (--surface) shared by Input, Select and Textarea, so a
// form control's look changes in one place. Layout (width, margin, text size)
// comes from the caller's Class.
const fieldBase = "rounded-md border border-border bg-surface"

// fieldBox is the single-line control's size (brand-guide S2/§4 forms: height
// 40, padding 12). Input and Select always carry it; Class must not override
// the height or padding.
const fieldBox = "h-10 px-3"

// textareaBox is the multi-line counterpart: 12px horizontal padding, height
// from `rows`.
const textareaBox = "px-3 py-1"

// fieldFocus is the form focus state (brand-guide C3): --focus border and a
// 2px --ring (--focus at 40%). `outline-none` is safe only because the ring
// is always drawn on the same element.
const fieldFocus = "focus-visible:border-focus focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus/40"

// InputProps is Input's input. Type is empty for "text". Class carries the
// layout/spacing classes appended to the shared border style (empty keeps
// the default `flex-1`, a row-filling field; pass e.g. `w-auto` or
// `mt-1` to opt out of `flex-1` inside a stacked label; height and padding
// are fixed by fieldBox). Attrs
// carries everything else (placeholder, required, min, value,
// autocomplete, data-testid, ...); a `true` value renders a bare boolean
// attribute.
type InputProps struct {
	ID    string
	Name  string
	Type  string
	Class string
	Attrs templ.Attributes
}

// Input renders a text-like <input> with the shared border style. An empty
// ID or Name omits the attribute (an empty `id=""` is invalid HTML).
templ Input(props InputProps) {
	<input
		if props.ID != "" {
			id={ props.ID }
		}
		class={ fieldClass(fieldBox, props.Class, "flex-1") }
		type={ inputType(props.Type) }
		if props.Name != "" {
			name={ props.Name }
		}
		{ props.Attrs... }
	/>
}

// SelectProps is Select's input. Class is as in InputProps (empty adds no
// layout classes). Attrs carries everything else (data-testid,
// required, ...). The <option>s are Select's children.
type SelectProps struct {
	ID    string
	Name  string
	Class string
	Attrs templ.Attributes
}

// Select renders a <select> with the shared border style around its
// <option> children. An empty ID or Name omits the attribute.
templ Select(props SelectProps) {
	<select
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		class={ fieldClass(fieldBox, props.Class, "") }
		{ props.Attrs... }
	>
		{ children... }
	</select>
}

// TextareaProps is Textarea's input. Class is as in InputProps (empty keeps
// no extra layout classes). Attrs carries everything else (rows, maxlength,
// required, data-testid, ...). The initial text is Textarea's children.
type TextareaProps struct {
	ID    string
	Name  string
	Class string
	Attrs templ.Attributes
}

// Textarea renders a <textarea> with the shared border and focus style. An
// empty ID or Name omits the attribute.
templ Textarea(props TextareaProps) {
	<textarea
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		class={ fieldClass(textareaBox, props.Class, "") }
		{ props.Attrs... }
	>{ children... }</textarea>
}

// fieldClass joins the shared shape, the control's box, the caller's Class
// (or fallback when Class is empty) and the focus state.
func fieldClass(box, class, fallback string) string {
	if class == "" {
		class = fallback
	}
	return strings.Join(strings.Fields(fieldBase+" "+box+" "+class+" "+fieldFocus), " ")
}

func inputType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}
