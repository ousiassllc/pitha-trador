package atoms

// State is the system-wide Running/Paused/Killed state
// (docs/components/overview.md §3 "atoms": "StatusDot（システム状態:
// Running=緑 / Paused=黄 / Killed=赤）"), used to pick StatusDot's color.
type State string

const (
	StateRunning State = "running"
	StatePaused  State = "paused"
	StateKilled  State = "killed"
)

// StatusDot renders a color-coded system-state indicator: green for
// Running, yellow for Paused, red for Killed/anything else (Kill Switch
// is the fail-safe default when state is unrecognized).
templ StatusDot(state State) {
	switch state {
		case StateRunning:
			<span class="inline-flex items-center gap-1 rounded-full border tone-success px-2 py-1 text-xs" data-state="running">
				@IconCheckCircle()
				稼働中
			</span>
		case StatePaused:
			<span class="inline-flex items-center gap-1 rounded-full border tone-warning px-2 py-1 text-xs" data-state="paused">
				@IconWarningTriangle()
				新規停止中
			</span>
		default:
			<span class="inline-flex items-center gap-1 rounded-full border tone-danger px-2 py-1 text-xs" data-state="killed">
				@IconXmarkCircle()
				全停止（Kill）
			</span>
	}
}
