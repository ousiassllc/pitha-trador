package atoms

// Direction is a Jev Trader directional call (functional.md §4.5),
// used to pick Badge's color (docs/components/overview.md §3
// "コンポーネントインターフェース規約").
type Direction string

const (
	DirectionLong  Direction = "LONG"
	DirectionShort Direction = "SHORT"
	DirectionNone  Direction = "NONE"
)

// Badge renders a color-coded direction label: green for LONG, red for
// SHORT, gray for NONE/anything else.
templ Badge(direction Direction) {
	switch direction {
		case DirectionLong:
			<span class="inline-flex items-center gap-1 rounded-full border tone-success px-2 py-1 text-xs">
				@IconNavArrowUp()
				LONG
			</span>
		case DirectionShort:
			<span class="inline-flex items-center gap-1 rounded-full border tone-danger px-2 py-1 text-xs">
				@IconNavArrowDown()
				SHORT
			</span>
		default:
			<span class="inline-flex items-center rounded-full border tone-mute px-2 py-1 text-xs">NONE</span>
	}
}

// EntryQualityBadge renders a JevEntryQuality* value (domain/jevdecision.go)
// as a color-coded label so entry quality is comparable at a glance:
// poor (mute) < fair (warning) < good (info) < strong / exceptional
// (success; the label tells those two apart). Unknown values fall back to mute. The
// class map is mirrored by `pitha-scanner-table`'s Lit render
// (static/src/components/scanner-table) so SSR and hydrated views match.
templ EntryQualityBadge(quality string) {
	switch quality {
		case "exceptional":
			<span class="inline-flex items-center rounded-full border tone-success px-2 py-1 text-xs">{ quality }</span>
		case "strong":
			<span class="inline-flex items-center rounded-full border tone-success px-2 py-1 text-xs">{ quality }</span>
		case "good":
			<span class="inline-flex items-center rounded-full border tone-info px-2 py-1 text-xs">{ quality }</span>
		case "fair":
			<span class="inline-flex items-center rounded-full border tone-warning px-2 py-1 text-xs">{ quality }</span>
		default:
			<span class="inline-flex items-center rounded-full border tone-mute px-2 py-1 text-xs">{ quality }</span>
	}
}
