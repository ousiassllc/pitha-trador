package atoms

// ButtonVariant picks a Button's color scheme: the four kinds of the Ousiass
// design guide §4 ("主 / サブ / ゴースト / 危険").
type ButtonVariant string

const (
	// ButtonPrimary is the solid ink (--accent) main action.
	ButtonPrimary ButtonVariant = "primary"
	// ButtonSecondary is the transparent bordered button (refresh, paging,
	// close, opening a dialog/panel).
	ButtonSecondary ButtonVariant = "secondary"
	// ButtonGhost is the borderless low-emphasis button.
	ButtonGhost ButtonVariant = "ghost"
	// ButtonDanger is the solid --danger destructive action (closing a
	// position, deleting a secret, promoting the live prompt).
	ButtonDanger ButtonVariant = "danger"
)

// ButtonSize picks a Button's padding and type size.
type ButtonSize string

const (
	// ButtonMedium is the default size.
	ButtonMedium ButtonSize = ""
	// ButtonSmall is the compact size for table rows and toolbars.
	ButtonSmall ButtonSize = "sm"
	// ButtonPager is the pagination size: height 36 (brand-guide O7).
	ButtonPager ButtonSize = "pager"
)

// ButtonProps is Button/ButtonLink's input. The zero value is a medium
// primary `type="button"`. Type is only used by Button (empty -> "button").
// Attrs carries everything else (data-testid, hx-*, aria-*, data-*, href
// for ButtonLink); a `true` value renders a bare boolean attribute.
type ButtonProps struct {
	Variant ButtonVariant
	Size    ButtonSize
	Type    string
	Attrs   templ.Attributes
}

// Button renders a <button> whose children are its label. All button
// colors, focus ring and the `disabled:opacity-40` state (which
// `hx-disabled-elt` relies on) live here so a visual change is one edit.
// A disabled button only dims (design guide O7): hover backgrounds use
// `not-disabled:` (not `enabled:`, which never matches ButtonLink's <a>).
templ Button(props ButtonProps) {
	<button class={ buttonClass(props) } type={ buttonType(props.Type) } data-ripple { props.Attrs... }>
		{ children... }
	</button>
}

// Every button carries `data-ripple`: static/src/components/ripple draws the
// press ripple (design guide §5), which `relative overflow-hidden` clips.

// ButtonLink renders an <a> styled as a Button (a navigation, not an
// action); pass the target via Attrs["href"].
templ ButtonLink(props ButtonProps) {
	<a class={ buttonClass(props) } data-ripple { props.Attrs... }>
		{ children... }
	</a>
}

func buttonType(t string) string {
	if t == "" {
		return "button"
	}
	return t
}

func buttonClass(props ButtonProps) string {
	const base = "relative inline-flex items-center justify-center overflow-hidden rounded-md font-semibold transition-[background-color] duration-base ease-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus disabled:opacity-40"
	size := "px-4 py-2 text-base"
	switch props.Size {
	case ButtonSmall:
		size = "min-h-8 px-3 text-sm"
	case ButtonPager:
		size = "min-h-9 px-3 text-sm"
	}
	var color string
	switch props.Variant {
	case ButtonDanger:
		color = "bg-danger text-bone"
	case ButtonSecondary:
		color = "border border-border bg-transparent text-ink not-disabled:hover:bg-accent-soft"
	case ButtonGhost:
		color = "text-ink not-disabled:hover:bg-accent-soft"
	default:
		color = "bg-accent text-bone"
	}
	return base + " " + size + " " + color
}
