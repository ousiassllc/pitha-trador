package jevprompt

import "github.com/ousiassllc/pitha-trador/internal/web/atoms"

// DayRow is one JST day of shadow cost.
type DayRow struct {
	Date  string
	Calls int
	USD   string
	// EstimatedCalls is how many of Calls were counted by an estimate
	// (EstimatedUSD of USD).
	EstimatedCalls int
	EstimatedUSD   string
}

// PromotionRow is one audit row of a promotion: who, when, from and to.
type PromotionRow struct {
	At   string
	By   string
	From string
	To   string
}

// PanelProps is Panel's input. Cost figures are USD strings already formatted.
type PanelProps struct {
	// ShadowRuns is false outside Paper: the shadow never runs there.
	ShadowRuns       bool
	Enabled          bool
	LiveVersion      string
	CandidateVersion string // "" for none
	Versions         []string
	// CapUSD is the daily cost cap; CapIsDefault says it is the default
	// (確定), not a value stored on this screen.
	CapUSD       string
	CapIsDefault bool
	// FailureCap and FailuresToday: the cap on failed shadow calls per JST day
	// (確定, a constant) and today's count.
	FailureCap    int
	FailuresToday int
	TodayDate     string
	TodayCalls    int
	TodayUSD      string
	TotalCalls    int
	TotalUSD      string
	// The Estimated* figures are the part of the cost counted by an estimate
	// (the response carried no usage); they are included in the totals above.
	TodayEstimatedCalls int
	TodayEstimatedUSD   string
	TotalEstimatedCalls int
	TotalEstimatedUSD   string
	Daily               []DayRow
	// HaltNote is the reason the shadow is stopped today ("" when it is not).
	HaltNote string
	// ThrottleNote is why the shadow stops for a while after the Jev API answered
	// 429/529, and how often it did today ("" when there is nothing to say).
	ThrottleNote string
	Promotions   []PromotionRow
	// Notice is the outcome of the action that produced this fragment.
	Notice string
}

// Panel renders the section (`#jev-prompt-panel`'s content). The shadow asks a
// candidate prompt the same question as every live decision and stores the
// answer apart; it never trades. The promotion switches the live prompt and is
// the only way a version becomes live.
templ Panel(props PanelProps) {
	<section class="flex flex-col gap-4 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-600" data-testid="jev-prompt-panel">
		<h3 class="sr-only">Jev プロンプトの版とシャドー比較</h3>
		if props.Notice != "" {
			<p class="text-emerald-700" role="status" data-testid="jev-prompt-notice">{ props.Notice }</p>
		}
		if !props.ShadowRuns {
			<p class="text-amber-700" role="status" data-testid="jev-prompt-not-paper">この動作モードは Paper ではないため、シャドーは動きません。</p>
		}
		<dl class="flex flex-col gap-1" data-testid="jev-prompt-live">
			<dt class="font-medium text-slate-700">ライブの版</dt>
			<dd><code data-testid="jev-prompt-live-version">{ props.LiveVersion }</code></dd>
		</dl>
		<form class="flex flex-col gap-3" hx-post="/settings/jev-prompt/shadow" hx-target="#jev-prompt-panel" hx-swap="innerHTML" hx-disabled-elt="find button" data-testid="jev-prompt-shadow-form">
			<div class="flex items-center gap-2">
				<label class="flex items-center gap-2">
					@atoms.Input(atoms.InputProps{Name: "enabled", Type: "checkbox", Class: "h-4 w-4 flex-none", Attrs: checkedAttrs(props.Enabled, "jev-prompt-enabled")})
					<span class="font-medium text-slate-700">シャドーを有効にする（Paper のみ）</span>
				</label>
				@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-jev-prompt-enabled", Label: "シャドーの説明"}) {
					Jev の trader に送るプロンプトには版があり、判断の記録に残ります。候補の版を「シャドー」で動かすと、ライブの判断ごとに同じ入力で候補の版にも答えさせ、別に保存します。シャドーの答えは取引（Policy・メタモデル・Risk・発注）にも、RAG・Calibration・メタモデルの学習にも一切使いません。Paper だけで動き、Live では動きません。既定はオフです。オンにすると、ライブの判断ごとに候補の版の LLM 呼び出しが 1 回増え、その費用が発生します。オンにできるのはこの画面だけです。
				}
			</div>
			<div class="flex flex-col gap-1">
				<label for="jev-prompt-candidate" class="font-medium text-slate-700">候補の版</label>
				@atoms.Select(atoms.SelectProps{ID: "jev-prompt-candidate", Name: "candidate", Class: "bg-white px-3 py-2", Attrs: templ.Attributes{"data-testid": "jev-prompt-candidate"}}) {
					<option value="" selected?={ props.CandidateVersion == "" }>（なし）</option>
					for _, v := range props.Versions {
						if v != props.LiveVersion {
							<option value={ v } selected?={ v == props.CandidateVersion }>{ v }</option>
						}
					}
				}
			</div>
			<div class="flex flex-col gap-1">
				<div class="flex items-center gap-2">
					<label for="jev-prompt-cap" class="font-medium text-slate-700">1 日あたりの費用上限（USD。日本時間の日）</label>
					@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-jev-prompt-cap", Label: "費用上限の説明"}) {
						超えるとその日のシャドーを止めます（ライブの判断は止まりません。翌日に再開します）。欄を空のまま保存すると既定値が使われます。変えたいときは値を入力して保存してください。保存した値を消して既定値に戻すには、欄を空にして保存します。失敗した呼び出し（応答が不正・保存に失敗・タイムアウトなど）は課金されても費用の合計に入らないため、1 日の回数の上限も別にあります。この回数は固定で、この画面では変えられません。
					}
				</div>
				@atoms.Input(atoms.InputProps{ID: "jev-prompt-cap", Name: "cap", Class: "bg-white px-3 py-2", Attrs: capAttrs(props)})
				<span class="text-xs text-slate-500" data-testid="jev-prompt-cap-note">
					if props.CapIsDefault {
						今の上限は <strong data-testid="jev-prompt-cap-effective">{ props.CapUSD } USD</strong>（既定値）。
					} else {
						今の上限は <strong data-testid="jev-prompt-cap-effective">{ props.CapUSD } USD</strong>（保存した値）。
					}
					<br/>
					<span data-testid="jev-prompt-failure-cap">失敗した呼び出しが 1 日に { itoa(props.FailureCap) } 回に達しても、その日のシャドーを止めます（今日: { itoa(props.FailuresToday) } 回）。</span>
				</span>
			</div>
			<div>
				@atoms.Button(atoms.ButtonProps{Type: "submit", Attrs: templ.Attributes{"data-testid": "jev-prompt-shadow-save"}}) {
					保存
				}
			</div>
		</form>
		<div class="flex flex-col gap-1" data-testid="jev-prompt-cost">
			<span class="flex items-center gap-2 font-medium text-slate-700">
				シャドーの費用
				@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-jev-prompt-cost", Label: "シャドーの費用の説明"}) {
					費用の合計は、各呼び出しの費用の合計です。API が返す入力トークン数に公表単価（入力 100 万トークンあたり 0.042 USD）を掛けた見積りで、請求書とは突き合わせていません（API は課金額を返しません）。応答に使用量（usage）が無かった呼び出しは、0 USD とは数えず、リクエストの大きさから保守的に推定した入力トークン数で費用に入れます（「うち見積り」。上限をすり抜けないため）。
				}
			</span>
			<span>今日（{ props.TodayDate }）: <strong data-testid="jev-prompt-cost-today">{ props.TodayUSD } USD</strong>（{ itoa(props.TodayCalls) } 回）　累計: <strong data-testid="jev-prompt-cost-total">{ props.TotalUSD } USD</strong>（{ itoa(props.TotalCalls) } 回）</span>
			if props.HaltNote != "" {
				<span class="text-amber-700" role="status" data-testid="jev-prompt-halt">{ props.HaltNote }</span>
			}
			if props.ThrottleNote != "" {
				<span class="text-amber-700" role="status" data-testid="jev-prompt-throttle">{ props.ThrottleNote }</span>
			}
			<span data-testid="jev-prompt-cost-estimated">うち見積り: 今日 <strong data-testid="jev-prompt-estimated-today">{ props.TodayEstimatedUSD } USD</strong>（{ itoa(props.TodayEstimatedCalls) } 回）　累計 <strong data-testid="jev-prompt-estimated-total">{ props.TotalEstimatedUSD } USD</strong>（{ itoa(props.TotalEstimatedCalls) } 回）</span>
			if len(props.Daily) > 0 {
				<table class="w-full text-left text-xs" aria-label="シャドーの日別費用" data-testid="jev-prompt-daily">
					<thead>
						<tr><th scope="col" class="pr-2">日（JST）</th><th scope="col" class="pr-2">回数</th><th scope="col" class="pr-2">費用（USD）</th><th scope="col">うち見積り（USD・回数）</th></tr>
					</thead>
					<tbody>
						for _, d := range props.Daily {
							<tr data-testid="jev-prompt-daily-row"><td class="pr-2">{ d.Date }</td><td class="pr-2">{ itoa(d.Calls) }</td><td class="pr-2">{ d.USD }</td><td>{ d.EstimatedUSD }（{ itoa(d.EstimatedCalls) } 回）</td></tr>
						}
					</tbody>
				</table>
			}
		</div>
		<form class="flex flex-col gap-2" hx-post="/settings/jev-prompt/promote" hx-target="#jev-prompt-panel" hx-swap="innerHTML" hx-disabled-elt="find button" hx-confirm="ライブの Jev プロンプトの版を切り替えます。以後のすべてのライブの判断（取引の入力）が新しい版になります。よろしいですか？" data-testid="jev-prompt-promote-form">
			<span class="flex items-center gap-2 font-medium text-slate-700">
				昇格（ライブの版を切り替える）
				@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-jev-prompt-promote", Label: "昇格の説明"}) {
					昇格はライブの判断を変えます。自動では行われず、この操作（と MCP からの昇格）だけで行われます。昇格は下の記録（新しい順・直近 10 件）に残ります。比較の結果は MCP からも見られます。
				}
			</span>
			<div class="flex flex-wrap items-center gap-2">
				@atoms.Select(atoms.SelectProps{Name: "version", Class: "bg-white px-3 py-2", Attrs: templ.Attributes{"data-testid": "jev-prompt-promote-version"}}) {
					for _, v := range props.Versions {
						if v != props.LiveVersion {
							<option value={ v } selected?={ v == props.CandidateVersion }>{ v }</option>
						}
					}
				}
				@atoms.Button(atoms.ButtonProps{Type: "submit", Variant: atoms.ButtonDangerOutline, Attrs: templ.Attributes{"data-testid": "jev-prompt-promote"}}) {
					この版をライブに昇格
				}
			</div>
		</form>
		<div class="flex flex-col gap-1" data-testid="jev-prompt-promotions">
			<span class="font-medium text-slate-700">昇格の記録</span>
			if len(props.Promotions) == 0 {
				<span class="text-xs text-slate-500" data-testid="jev-prompt-promotions-empty">記録はありません。</span>
			} else {
				<table class="w-full text-left text-xs" aria-label="昇格の記録" data-testid="jev-prompt-promotions-table">
					<thead>
						<tr><th scope="col" class="pr-2">日時</th><th scope="col" class="pr-2">誰が</th><th scope="col" class="pr-2">前の版</th><th scope="col">後の版</th></tr>
					</thead>
					<tbody>
						for _, p := range props.Promotions {
							<tr data-testid="jev-prompt-promotion-row"><td class="pr-2">{ p.At }</td><td class="pr-2">{ p.By }</td><td class="pr-2"><code>{ p.From }</code></td><td><code>{ p.To }</code></td></tr>
						}
					</tbody>
				</table>
			}
		</div>
	</section>
}

func checkedAttrs(on bool, testID string) templ.Attributes {
	attrs := templ.Attributes{"value": "on", "data-testid": testID}
	if on {
		attrs["checked"] = true
	}
	return attrs
}

// capAttrs is the cap input: while the default is in force the field is empty
// and shows it as a placeholder, so saving the form without typing a value
// stores nothing (a stored value only ever comes from a person typing one).
func capAttrs(props PanelProps) templ.Attributes {
	attrs := templ.Attributes{"inputmode": "decimal", "autocomplete": "off", "data-testid": "jev-prompt-cap"}
	if props.CapIsDefault {
		attrs["placeholder"] = props.CapUSD + "（既定値）"
	} else {
		attrs["value"] = props.CapUSD
	}
	return attrs
}
