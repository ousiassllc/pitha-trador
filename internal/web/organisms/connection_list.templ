package organisms

import (
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
)

// ConnectionList is the connection list shared by Settings and the
// first-run Setup screen (issue #302): one molecules.SettingsCard per
// connection with its 設定済み/未設定 status, plus one molecules.Modal per
// connection holding that connection's molecules.SecretFieldRow forms - the
// key, URL and model name together. Every row keeps its own independent
// `POST`/`DELETE /settings/:key` forms (issue #79), so editing one field
// never touches another's stored value, and a save/delete refreshes the
// card's status out-of-band (handler/settings.SettingsHandler.renderRow).
// The connection's Description is not printed: it is the text of the help
// mark next to its status (issue #902). The modals open through the
// `pitha-modal` script, which the hosting page must load.
templ ConnectionList(connections []molecules.ConnectionProps) {
	<ul class="flex flex-col gap-3" data-testid="connection-list">
		for _, connection := range connections {
			@molecules.SettingsCard(molecules.SettingsCardProps{
				ID:          connection.ID,
				ModalID:     connection.ModalID(),
				Name:        connection.Name,
				ActionLabel: "設定する",
				Status:      connectionStatusWithHelp(connection),
			})
		}
	</ul>
	for _, connection := range connections {
		@molecules.Modal(connection.ModalID(), connection.Name) {
			<p class="text-sm text-slate-600">
				保存・削除の反映には再起動が必要です。
				if len(connection.Fields) > 1 {
					<span data-testid={ connection.ModalID() + "-defaults-note" }>
						@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-" + connection.ID + "-defaults", Label: connection.Name + "の上書き項目の説明"}) {
							URL やモデル名などの上書き項目は、空欄（未設定）のとき既定値を使用します。保存済みの上書き値は「削除」で既定値に戻せます。保存済みの値はセキュリティのため画面上に表示されません（変更する場合は新しい値を入力して保存してください）。
						}
					</span>
				}
			</p>
			for _, field := range connection.Fields {
				@molecules.SecretFieldRow(field)
			}
		}
	}
}

// connectionStatusWithHelp is the card's status badge plus the help mark
// holding the connection's description. The mark sits beside the badge, not
// inside it, because Save/Delete replace the badge out-of-band.
templ connectionStatusWithHelp(connection molecules.ConnectionProps) {
	@molecules.ConnectionStatus(connection, false)
	if connection.Description != "" {
		@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-" + connection.ID, Label: connection.Name + "の説明"}) {
			{ connection.Description }
		}
	}
}
