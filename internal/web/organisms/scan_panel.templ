package organisms

import (
	"net/url"
	"strconv"
	"time"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// ScanPanelView is ScanPanel's view model (issue #303). Cycle/Summary are
// only meaningful when HasCycle; Page only when Open.
type ScanPanelView struct {
	HasCycle bool
	Cycle    domain.ScanCycle
	Summary  domain.ScanSummary
	// Open shows the filter form and per-symbol list under the funnel;
	// closed shows the funnel and the "スキャン対象を見る" entry only.
	Open  bool
	Query domain.ScanQuery
	Page  domain.ScanPage
	// OffSession is true outside TSE trading hours (issue #367): the
	// Scheduler's SessionGate has stopped market-data fetch, full scans and
	// Jev Scout, so the panel shows a stop notice. NextOpen is the next
	// session start (JST) and is zero when unknown.
	OffSession bool
	NextOpen   time.Time
	// Universe*: the 銘柄マスタ未投入 state and a just-run JPX import's
	// result (issue #508; see scanUniverseEmpty/scanUniverseImported).
	UniverseEmpty       bool
	UniverseImported    int
	UniverseImportError string
}

const scanPanelURL = "/scanner/scan"

// scanExportURL is the scan CSV download endpoint.
const scanExportURL = "/api/v1/scanner/scan/export"

// ScanPanel is the Scanner Dashboard's scan-status panel (issue #303,
// functional.md §5.1): the latest scan cycle's funnel (universe ->
// features -> Fast Screener -> Scout), its time and duration, a manual
// refresh button, and - once opened via "スキャン対象を見る" - a filterable,
// paged list of every universe symbol with its pass/exclude/missing
// status and reasons. It is a snapshot: it is fetched when the page is
// opened and again only by the refresh button / filter / pager (all
// `hx-get /scanner/scan` swapping this section), never pushed over
// `/ws/scanner`. Without a cycle (nothing scanned yet) it shows an empty
// state instead of the funnel. Outside TSE trading hours it also shows a
// stop notice (both with and without a cycle) while the refresh button
// stays enabled: it only re-reads stored data.
templ ScanPanel(v ScanPanelView) {
	<section class="mt-6 rounded-md border border-slate-200 bg-white p-4" id="scan-panel" data-testid="scan-panel">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h2 class="text-base font-semibold text-slate-900">スキャン状況</h2>
			<div class="flex items-center gap-2">
				if !v.Open {
					@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonOutline, Size: atoms.ButtonSmall, Attrs: templ.Attributes{"hx-get": scanPanelURL, "hx-target": "#scan-panel", "hx-swap": "outerHTML", "data-testid": "scan-open"}}) {
						スキャン対象を見る
					}
				}
				@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Size: atoms.ButtonSmall, Attrs: templ.Attributes{"hx-get": scanHref(v.Query, v.Query.Page, v.Open), "hx-target": "#scan-panel", "hx-swap": "outerHTML", "data-testid": "scan-refresh"}}) {
					更新
				}
			</div>
		</div>
		if v.OffSession {
			@scanOffHours(v.NextOpen)
		}
		@scanUniverseImported(v.UniverseImported)
		if v.UniverseEmpty {
			@scanUniverseEmpty(v.UniverseImportError)
		} else if !v.HasCycle {
			<p class="mt-3 rounded-md border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500" data-testid="scan-empty">
				まだスキャンサイクルが実行されていません。最初のサイクルが完了すると、対象銘柄数や各段階の通過件数がここに表示されます。「更新」で再取得できます。
			</p>
		} else {
			<p class="mt-1 text-xs text-slate-500" data-testid="scan-cycle-meta">
				最終サイクル { atoms.FormatJST(v.Cycle.FinishedAt) }（所要 { formatCycleDuration(v.Cycle.Duration()) }）。ページを開いた時点または「更新」押下時のスナップショットです。
			</p>
			@scanFunnel(v)
			<p class="mt-2 text-xs text-slate-500">
				通過 <span data-testid="scan-count-passed">{ strconv.Itoa(v.Summary.Passed) }</span>
				／ 除外 <span data-testid="scan-count-excluded">{ strconv.Itoa(v.Summary.Excluded) }</span>
				／ データ欠損 <span data-testid="scan-count-missing">{ strconv.Itoa(v.Summary.Missing) }</span>
				銘柄（Fast Screenerの判定。通過のうち絞り込み上位N件の外は「除外」に数えます）
			</p>
			if v.Open {
				@scanList(v)
			}
		}
	</section>
}

templ scanOffHours(nextOpen time.Time) {
	<p class="mt-3 rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900" role="status" data-testid="scan-offhours">
		現在は東証の立会時間外のため、市場データ取得・フルスキャン・Jev Scoutは停止中です。表示は保存済みデータに基づきます（「更新」で保存済みデータを再取得するだけで、新規スキャンは実行されません）。
		if !nextOpen.IsZero() {
			<span data-testid="scan-resume-at">次回の立会開始: { formatNextOpen(nextOpen) }</span>
		}
	</p>
}

templ scanFunnel(v ScanPanelView) {
	<ol class="mt-3 grid gap-2 sm:grid-cols-4" data-testid="scan-funnel">
		@funnelStep("ユニバース", "スキャン対象の銘柄数。ランキング監視（既定）では監視銘柄（最大45）、scan.full_scan_enabled: true のときだけ東証上場の全銘柄", strconv.Itoa(v.Cycle.Funnel.Universe), "scan-funnel-universe")
		@funnelStep("特徴量算出", "市況データ（特徴量）が算出できた銘柄数", strconv.Itoa(v.Cycle.Funnel.FeatureComputed), "scan-funnel-features")
		@funnelStep("Fast Screener通過", "足切り条件を満たし上位N件に入った銘柄数（Jev Scout候補）", strconv.Itoa(v.Cycle.Funnel.FastScreenerPassed), "scan-funnel-fast")
		@funnelStep("Scout通過", "Jev Scoutの判定が済んだ候補のうち通過した銘柄数（"+strconv.Itoa(v.Cycle.Funnel.ScoutEvaluated)+"/"+strconv.Itoa(v.Cycle.Funnel.FastScreenerPassed)+"件判定済み）", strconv.Itoa(v.Cycle.Funnel.ScoutPassed), "scan-funnel-scout")
	</ol>
}

templ funnelStep(label, hint, count, testID string) {
	<li class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2" title={ hint }>
		<div class="text-xs text-slate-600">{ label }</div>
		<div class="text-xl font-semibold tabular-nums text-slate-900" data-testid={ testID }>{ count }</div>
	</li>
}

// scanFieldClass is the filter form's layout for atoms.Input/atoms.Select
// (stacked under a label, so no flex-1).
const scanFieldClass = "mt-1 px-2 py-1 text-sm"

templ scanList(v ScanPanelView) {
	<form class="mt-4 flex flex-wrap items-end gap-3 text-sm" method="get" action={ scanPanelURL } hx-get={ scanPanelURL } hx-target="#scan-panel" hx-swap="outerHTML" hx-trigger="submit, change from:#scan-status, change from:#scan-reason" data-testid="scan-filter">
		<label class="flex flex-col text-xs text-slate-600">
			銘柄コード・名称
			@atoms.Input(atoms.InputProps{ID: "scan-q", Name: "q", Type: "search", Class: scanFieldClass, Attrs: templ.Attributes{"value": v.Query.Q, "maxlength": "64"}})
		</label>
		<label class="flex flex-col text-xs text-slate-600">
			状態
			@atoms.Select(atoms.SelectProps{ID: "scan-status", Name: "status", Class: scanFieldClass}) {
				@scanOption("", "すべて", string(v.Query.Status) == "")
				@scanOption(string(domain.ScanStatusPassed), "通過", v.Query.Status == domain.ScanStatusPassed)
				@scanOption(string(domain.ScanStatusExcluded), "除外", v.Query.Status == domain.ScanStatusExcluded)
				@scanOption(string(domain.ScanStatusMissing), "データ欠損", v.Query.Status == domain.ScanStatusMissing)
			}
		</label>
		<label class="flex flex-col text-xs text-slate-600">
			理由
			@atoms.Select(atoms.SelectProps{ID: "scan-reason", Name: "reason", Class: scanFieldClass}) {
				@scanOption("", "すべて", v.Query.Reason == nil)
				for _, r := range domain.AllScreenReasons() {
					if n, applied := v.Summary.ByReason[r], v.Query.Reason != nil && *v.Query.Reason == r; n > 0 || applied {
						@scanOption(r.Code(), r.Label()+"（"+strconv.Itoa(n)+"）", applied)
					}
				}
			}
		</label>
		@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Size: atoms.ButtonSmall, Type: "submit"}) {
			絞り込む
		}
	</form>
	<div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm text-slate-600">
		<p data-testid="scan-total">
			該当 <span class="font-semibold text-slate-900">{ strconv.Itoa(v.Page.Total) }</span> 銘柄
			（{ strconv.Itoa(v.Page.Page) } / { strconv.Itoa(v.Page.Pages) } ページ）
		</p>
		<a class="text-xs text-sky-700 underline-offset-2 hover:underline" href={ templ.SafeURL(scanExportHref(v.Query)) } hx-disable data-testid="scan-export" title="現在の絞り込み条件に該当する全銘柄（ページ分割なし）をCSVでダウンロードします">CSVダウンロード（絞り込み結果すべて）</a>
	</div>
	<div class="mt-2 overflow-x-auto rounded-md border border-slate-200">
		<table class="w-full border-collapse text-left text-sm" aria-label="スキャン対象銘柄" data-testid="scan-table">
			<thead>
				<tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
					<th scope="col" class="whitespace-nowrap px-3 py-2">銘柄コード</th>
					<th scope="col" class="whitespace-nowrap px-3 py-2">名称</th>
					<th scope="col" class="whitespace-nowrap px-3 py-2">市場</th>
					<th scope="col" class="whitespace-nowrap px-3 py-2">状態</th>
					<th scope="col" class="px-3 py-2">理由</th>
					<th scope="col" class="whitespace-nowrap px-3 py-2">Scout</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range v.Page.Symbols {
					@scanRow(s, v.Cycle.Scout[s.Symbol])
				}
			</tbody>
		</table>
	</div>
	if len(v.Page.Symbols) == 0 {
		<p class="mt-3 rounded-md border border-dashed border-slate-300 bg-slate-50 px-4 py-4 text-center text-sm text-slate-500" data-testid="scan-no-match">条件に一致する銘柄はありません。</p>
	}
	<nav class="mt-3 flex items-center justify-between text-xs" aria-label="ページ送り" data-testid="scan-pager">
		if v.Page.Page > 1 {
			@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Size: atoms.ButtonSmall, Attrs: templ.Attributes{"hx-get": scanHref(v.Query, v.Page.Page-1, true), "hx-target": "#scan-panel", "hx-swap": "outerHTML", "data-testid": "scan-prev"}}) {
				前へ
			}
		} else {
			<span></span>
		}
		if v.Page.Page < v.Page.Pages {
			@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Size: atoms.ButtonSmall, Attrs: templ.Attributes{"hx-get": scanHref(v.Query, v.Page.Page+1, true), "hx-target": "#scan-panel", "hx-swap": "outerHTML", "data-testid": "scan-next"}}) {
				次へ
			}
		}
	</nav>
}

// scanHref is the panel URL for q at page. Only non-default parts are
// included, so the default closed refresh is `/scanner/scan?open=0`.
func scanHref(q domain.ScanQuery, page int, open bool) string {
	v := url.Values{}
	if !open {
		v.Set("open", "0")
	}
	if q.Q != "" {
		v.Set("q", q.Q)
	}
	if q.Status != "" {
		v.Set("status", string(q.Status))
	}
	if q.Reason != nil {
		v.Set("reason", q.Reason.Code())
	}
	if page > 1 {
		v.Set("page", strconv.Itoa(page))
	}
	if q.PageSize > 0 && q.PageSize != domain.DefaultScanPageSize {
		v.Set("page_size", strconv.Itoa(q.PageSize))
	}
	if len(v) == 0 {
		return scanPanelURL
	}
	return scanPanelURL + "?" + v.Encode()
}

// scanExportHref is the CSV download URL (`GET /api/v1/scanner/scan/export`)
// for q's filters; paging does not apply to the export.
func scanExportHref(q domain.ScanQuery) string {
	v := url.Values{}
	if q.Q != "" {
		v.Set("q", q.Q)
	}
	if q.Status != "" {
		v.Set("status", string(q.Status))
	}
	if q.Reason != nil {
		v.Set("reason", q.Reason.Code())
	}
	if len(v) == 0 {
		return scanExportURL
	}
	return scanExportURL + "?" + v.Encode()
}
