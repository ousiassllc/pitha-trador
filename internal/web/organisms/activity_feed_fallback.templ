package organisms

import (
	"strconv"
	"time"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/labels"
)

// ActivityFeedFallback renders System Activity Log's activity table
// (functional.md §5.5, components/overview.md §3): Time, Type, Symbol,
// Detail, and Latency (ms), newest first. It is the SSR/no-JS
// rendering that `<pitha-activity-feed>` (static/src/components/
// activity-feed) replaces in place once it hydrates, adding type/queue
// filters and `/ws/activity` live updates.
templ ActivityFeedFallback(events []domain.ActivityEvent, asOf time.Time) {
	<section class="mt-12" id="activity-feed" data-testid="activity-feed">
		<h2 class="mb-2 text-xl font-semibold text-ink">最近の動き</h2>
		<table class="w-full border-collapse text-left text-sm" aria-label="アクティビティフィード">
			<caption class="mb-2 text-left text-sm text-mute">{ atoms.FormatJST(asOf) } 時点</caption>
			<thead>
				<tr class="border-b border-border text-xs font-semibold text-mute">
					<th scope="col" class="px-3 py-2.5">時刻</th>
					<th scope="col" class="px-3 py-2.5">種別</th>
					<th scope="col" class="px-3 py-2.5">銘柄</th>
					<th scope="col" class="px-3 py-2.5">内容</th>
					<th scope="col" class="px-3 py-2.5 text-right">応答時間（ms）</th>
				</tr>
			</thead>
			<tbody>
				for _, e := range events {
					<tr class="border-b border-border" data-event-type={ e.Type }>
						<td class="px-3 py-2.5">{ atoms.FormatJST(e.Timestamp) }</td>
						<td class="px-3 py-2.5 text-ink">{ labels.ActivityType(e.Type) }</td>
						<td class="px-3 py-2.5">{ dashIfEmpty(e.Symbol) }</td>
						<td class="px-3 py-2.5">{ labels.ActivityDetail(e.Type, e.Detail) }</td>
						<td class="px-3 py-2.5 text-right font-mono tabular-nums">{ latencyText(e.LatencyMs) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

func dashIfEmpty(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

func latencyText(ms *int) string {
	if ms == nil {
		return "—"
	}
	return strconv.Itoa(*ms)
}
