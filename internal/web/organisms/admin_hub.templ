package organisms

import (
	"github.com/ousiassllc/pitha-trador/internal/web/adminhub"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// AdminHub is the admin hub's body (issue #793): one section per
// adminhub.Category, each a list of the admin screens/functions in it with
// what they do and a button that goes there. A `/settings#<dialog id>` target
// opens that Settings dialog on arrival (pitha-modal).
templ AdminHub(sections []adminhub.Section) {
	<div class="mt-4 flex flex-col gap-6" data-testid="admin-hub">
		<p class="text-sm text-slate-600">
			設定・運用・検証・保守の入口を目的別にまとめています。各画面のヘッダーにある「管理」からいつでもここに戻れます。
		</p>
		for _, section := range sections {
			<section class="flex flex-col gap-3" aria-labelledby={ "admin-" + section.Category.ID + "-heading" } data-testid={ "admin-category-" + section.Category.ID }>
				<h2 id={ "admin-" + section.Category.ID + "-heading" } class="text-lg font-semibold text-slate-900">{ section.Category.Name }</h2>
				<p class="text-sm text-slate-500">{ section.Category.Summary }</p>
				<ul class="flex flex-col gap-3">
					for _, entry := range section.Entries {
						@AdminHubEntry(entry)
					}
				</ul>
			</section>
		}
	</div>
}

// AdminHubEntry is one hub row: the name, what you can do there, and a link
// button to the page (or Settings dialog) that holds it.
templ AdminHubEntry(entry adminhub.Entry) {
	<li class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-slate-200 bg-white p-4" data-testid="admin-entry">
		<div class="flex min-w-0 flex-1 flex-col gap-1">
			<a class="font-semibold text-slate-900 hover:underline" href={ templ.SafeURL(entry.Href) }>{ entry.Name }</a>
			<p class="text-sm text-slate-600">{ entry.Description }</p>
		</div>
		@atoms.ButtonLink(atoms.ButtonProps{Variant: atoms.ButtonOutline, Attrs: templ.Attributes{
			"href":        templ.SafeURL(entry.Href),
			"aria-label":  entry.Name + "を開く",
			"data-testid": "admin-open",
		}}) {
			開く
		}
	</li>
}
