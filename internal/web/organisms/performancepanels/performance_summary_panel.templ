package performancepanels

import (
	"fmt"
	"math"

	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// PerformanceSummary is PerformanceSummaryPanel's plain-props view of one
// backtest metric set (internal/web/handler maps backtest.Metrics onto
// it), so organisms stay decoupled from internal/service. Return figures
// are percentage returns summed over trades. ProfitFactor is +Inf when
// there are wins and no losses.
type PerformanceSummary struct {
	TradeCount     int
	WinRate        float64
	AvgProfit      float64
	AvgLoss        float64
	ProfitFactor   float64
	Expectancy     float64
	MaxDrawdownPct float64
	GrossPnLPct    float64
	SlippagePnLPct float64
	FeePnLPct      float64
	NetPnLPct      float64
}

// PerformanceSummaryPanel renders one PerformanceSummary: trade count, win
// rate, average profit/loss, Profit Factor, Expectancy, Max Drawdown and
// gross/slippage/fee/net PnL, each with a help mark.
templ PerformanceSummaryPanel(title string, m PerformanceSummary) {
	<section class="mb-6 rounded-lg border border-slate-200 bg-white p-6 shadow" data-testid="performance-summary">
		<h2 class="text-lg font-semibold text-slate-900">
			{ title }
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-backtest-summary", Label: title + "の説明"}) {
				全フォールドの Forward 期間（学習に使っていない期間）の成績を合算した値です。損益は取引ごとのリターン（%）の合計で、金額ではありません。
			}
		</h2>
		<dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
			@summaryMetric("取引数", "trades", "trade_count", fmt.Sprintf("%d", m.TradeCount), "Trades。Forward 期間にバックテストが仮想的に約定した取引の数です。")
			@summaryMetric("勝率", "win-rate", "win_rate", fmt.Sprintf("%.1f%%", m.WinRate*100), "Win Rate。コスト控除後に利益が出た取引の割合です。")
			@summaryMetric("平均利益", "avg-profit", "", pct(m.AvgProfit), "Avg Profit。勝った取引の平均リターン（コスト控除後、%）です。")
			@summaryMetric("平均損失", "avg-loss", "", pct(m.AvgLoss), "Avg Loss。負けた取引の平均リターン（コスト控除後、%）です。")
			@summaryMetric("プロフィットファクター", "profit-factor", "profit_factor", profitFactor(m.ProfitFactor), "Profit Factor。総利益 ÷ 総損失です。1 を超えると利益が損失を上回ります。負けた取引がないときは「∞」と表示します。")
			@summaryMetric("期待値", "expectancy", "expectancy", pct(m.Expectancy), "Expectancy。全取引の平均リターン（コスト控除後、%）です。")
			@summaryMetric("最大ドローダウン", "max-drawdown", "max_drawdown_pct", pct(m.MaxDrawdownPct), "Max Drawdown。累積リターンが直前のピークから最も大きく下がった幅（%）です。")
			@summaryMetric("総損益（コスト前）", "gross-pnl", "", pct(m.GrossPnLPct), "Gross PnL。約定コストと手数料を引く前のリターンの合計（%）です。")
			@summaryMetric("損益（スリッページ）", "slippage-pnl", "", pct(m.SlippagePnLPct), "PnL (slippage)。スプレッドやスリッページなどの約定コストを織り込んだ後、手数料を引く前のリターンの合計（%）です。")
			@summaryMetric("損益（手数料）", "fee-pnl", "", pct(m.FeePnLPct), "PnL (fees)。手数料によるリターンの増減の合計（%）です。")
			@summaryMetric("純損益", "net-pnl", "net_pnl_pct", pct(m.NetPnLPct), "Net PnL。コストと手数料をすべて引いた後のリターンの合計（%）です。")
		</dl>
	</section>
}

// summaryMetric is one labelled figure of PerformanceSummaryPanel with a help
// mark (id is the mark's id suffix); the English metric name leads the help
// text. key is the `data-metric` attribute, omitted when empty.
templ summaryMetric(label, id, key, value, help string) {
	<div>
		<dt class="text-sm text-slate-500">
			{ label }
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-backtest-summary-" + id, Label: label + "の説明"}) {
				{ help }
			}
		</dt>
		if key != "" {
			<dd class="text-sm font-medium text-slate-900" data-metric={ key }>{ value }</dd>
		} else {
			<dd class="text-sm font-medium text-slate-900">{ value }</dd>
		}
	</div>
}

func pct(v float64) string {
	return fmt.Sprintf("%.2f%%", v)
}

// profitFactor renders +Inf (wins with no losses, backtest.Aggregate's
// documented value) as "∞" instead of Go's "+Inf".
func profitFactor(v float64) string {
	if math.IsInf(v, 1) {
		return "∞"
	}
	return fmt.Sprintf("%.2f", v)
}
