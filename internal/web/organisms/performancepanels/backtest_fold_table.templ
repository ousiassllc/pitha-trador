package performancepanels

import (
	"fmt"
	"time"

	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// BacktestFold is one Walk Forward fold's Forward period and metrics.
// ForwardEnd is the exclusive end of the day-granular period.
type BacktestFold struct {
	ForwardStart time.Time
	ForwardEnd   time.Time
	Forward      PerformanceSummary
}

// BacktestFoldTable is the Performance page's "Folds" panel: each fold's
// Forward period and out-of-sample metrics.
templ BacktestFoldTable(folds []BacktestFold) {
	<section class="mb-6 rounded-lg border border-slate-200 bg-white p-6 shadow" data-testid="backtest-folds">
		<h2 class="text-lg font-semibold text-slate-900">
			フォールド別
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-backtest-folds", Label: "フォールド別の説明"}) {
				各フォールドの Forward 期間（学習に使っていない期間）の成績です。取引数・勝率・期待値・最大ドローダウン・純損益の意味は、上の合算表と同じです。
			}
		</h2>
		<table class="mt-4 w-full border-collapse text-left text-sm" aria-label="Walk Forward 結果（フォールド別）">
			<thead>
				<tr class="border-b border-slate-200 text-xs font-semibold text-slate-500">
					<th scope="col" class="px-3 py-2">Forward 期間</th>
					<th scope="col" class="px-3 py-2">取引数</th>
					<th scope="col" class="px-3 py-2">勝率</th>
					<th scope="col" class="px-3 py-2">期待値</th>
					<th scope="col" class="px-3 py-2">最大ドローダウン</th>
					<th scope="col" class="px-3 py-2">純損益</th>
				</tr>
			</thead>
			<tbody>
				for _, f := range folds {
					<tr class="border-b border-slate-100">
						<td class="px-3 py-2">{ f.ForwardStart.Format("2006-01-02") } – { lastDay(f.ForwardEnd) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%d", f.Forward.TradeCount) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.1f%%", f.Forward.WinRate*100) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.2f%%", f.Forward.Expectancy) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.2f%%", f.Forward.MaxDrawdownPct) }</td>
						<td class="px-3 py-2">{ fmt.Sprintf("%.2f%%", f.Forward.NetPnLPct) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

// lastDay renders the final (inclusive) day of a day-granular period whose
// exclusive end is end.
func lastDay(end time.Time) string {
	return end.Add(-time.Nanosecond).Format("2006-01-02")
}
