package organisms

import "fmt"

// RiskParams is RiskPanel's input: the risk figures applying to a symbol,
// in percent. internal/web/handler/symbol maps its SymbolRiskParams onto it
// (organisms cannot import handler packages).
type RiskParams struct {
	AllowedPositionPct float64
	StopLossPct        float64
	TakeProfitPct      float64
}

// RiskPanel is Symbol Detail's "Risk" panel: allowed position size, stop
// loss and take profit.
templ RiskPanel(p RiskParams) {
	<section class="mb-6 rounded-lg border border-slate-200 bg-white p-6 shadow" id="risk-panel" data-testid="risk-panel">
		<h2 class="text-lg font-semibold text-slate-900">Risk</h2>
		<dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
			<div>
				<dt class="text-sm text-slate-500">Allowed Position</dt>
				<dd class="text-sm font-medium text-slate-900">{ fmt.Sprintf("%.2f%%", p.AllowedPositionPct) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Stop</dt>
				<dd class="text-sm font-medium text-slate-900">{ fmt.Sprintf("%.2f%%", p.StopLossPct) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Take Profit</dt>
				<dd class="text-sm font-medium text-slate-900">{ fmt.Sprintf("%.2f%%", p.TakeProfitPct) }</dd>
			</div>
		</dl>
	</section>
}
