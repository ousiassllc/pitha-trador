package organisms

import "github.com/ousiassllc/pitha-trador/internal/domain"

templ scanOption(value, label string, selected bool) {
	<option value={ value } selected?={ selected }>{ label }</option>
}

templ scanRow(s domain.ScanSymbol, scout domain.ScoutOutcome) {
	<tr class="border-b border-border align-top last:border-b-0 hover:bg-accent-soft" data-symbol={ s.Symbol } data-status={ string(s.Status()) }>
		<td class="px-3 py-2">
			<a class="text-accent underline-offset-2 hover:underline" href={ SymbolHref(s.Symbol) }>{ s.Symbol }</a>
		</td>
		<td class="px-3 py-2">{ s.Name }</td>
		<td class="whitespace-nowrap px-3 py-2">{ s.Market }</td>
		<td class="whitespace-nowrap px-3 py-2">
			<span class={ "inline-flex items-center rounded-full px-2 py-1 text-xs", scanStatusClass(s.Status()) }>{ scanStatusLabel(s.Status()) }</span>
		</td>
		<td class="px-3 py-2 text-sm text-ink">
			if reasons := s.Reasons.List(); len(reasons) == 0 {
				<span class="text-mute">—</span>
			} else {
				<ul>
					for _, r := range reasons {
						<li data-reason={ r.Code() }>{ r.Label() }</li>
					}
				</ul>
			}
		</td>
		<td class="whitespace-nowrap px-3 py-2 text-sm">{ scanScoutLabel(s, scout) }</td>
	</tr>
}

func scanStatusLabel(s domain.ScanStatus) string {
	switch s {
	case domain.ScanStatusPassed:
		return "通過"
	case domain.ScanStatusMissing:
		return "データ欠損"
	default:
		return "除外"
	}
}

func scanStatusClass(s domain.ScanStatus) string {
	switch s {
	case domain.ScanStatusPassed:
		return "border tone-success"
	case domain.ScanStatusMissing:
		return "border tone-warning"
	default:
		return "border tone-mute"
	}
}

// scanScoutLabel is the Scout column: only a Fast Screener candidate has
// a Scout stage; until its job completes it is pending.
func scanScoutLabel(s domain.ScanSymbol, o domain.ScoutOutcome) string {
	switch {
	case s.Status() != domain.ScanStatusPassed:
		return "—"
	case o == domain.ScoutPassed:
		return "通過"
	case o == domain.ScoutFailed:
		return "不通過"
	case o == domain.ScoutError:
		return "判定エラー"
	default:
		return "判定待ち"
	}
}
