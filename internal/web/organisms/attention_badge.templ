package organisms

import "strconv"

// AttentionBadgeURL is the fragment Header's `#attention-badge` fetches.
const AttentionBadgeURL = "/home/attention-badge"

// AttentionBadge is the header's condensed alert (issue #896): 「要対応 N 件」
// linking to the Home screen, where each condition is listed in full with where
// to look. It replaces the banners (connection, daily halt, health alerts,
// unset optional keys, update) that used to stack under the header on every
// page. Nothing is rendered for count 0.
templ AttentionBadge(count int) {
	if count > 0 {
		<a
			class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900 hover:bg-amber-100"
			href="/"
			data-testid="attention-badge"
			data-count={ strconv.Itoa(count) }
		>要対応 { strconv.Itoa(count) } 件</a>
	}
}
