package organisms

import "strings"

// SecretsBanner renders the全ページ共通バナー (issue #57 スコープ item 7)
// Header's `#config-banner` fetches via `GET /system/secrets-status`
// (hx-trigger="load", the same self-correcting pattern `#header-status`
// uses for organisms.SystemStatusBadge). unset lists the optional
// secrets-table keys (config.KeySlackWebhookURL etc.) that have no stored
// value yet. The required keys (JEV_API_KEY/KABU_API_PASSWORD)
// never appear here: while one is unset, Setup Guard redirects every page
// to `/setup` instead (issue #80), so this banner is only ever seen once
// they are configured. It renders nothing once unset is empty. It takes no
// margin of its own: `#config-banner` places it on its own last row
// like the other banners (issue #625).
templ SecretsBanner(unset []string) {
	if len(unset) > 0 {
		<div class="rounded-md border border-yellow-300 bg-yellow-50 px-4 py-3 text-sm text-yellow-800" role="alert" data-testid="secrets-banner">
			<p>
				任意項目が未設定です: { strings.Join(unset, ", ") }。必要に応じて
				<a class="font-semibold underline" href="/settings">設定画面</a>から入力してください。
			</p>
		</div>
	}
}
