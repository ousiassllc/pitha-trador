package organisms

import "strings"

// SecretsBanner renders the全ページ共通バナー (issue #57 スコープ item 7)
// Header's `#config-banner` fetches via `GET /system/secrets-status`
// (hx-trigger="load", the same self-correcting pattern `#header-status`
// uses for organisms.SystemStatusBadge). missing lists every required
// secrets-table key (config.KeyJevAPIKey/KeyJevBaseURL/
// KeyKabuAPIPassword - config.KeySlackWebhookURL is optional and never
// appears here, matching config.LoadSecretsFromDB's own "missing"
// semantics) that has no stored value yet. It renders nothing once
// missing is empty.
templ SecretsBanner(missing []string) {
	if len(missing) > 0 {
		<div role="alert" data-testid="secrets-banner">
			<p>
				未設定の項目があります: { strings.Join(missing, ", ") }。
				<a href="/settings">設定画面</a>から入力してください。
			</p>
		</div>
	}
}
