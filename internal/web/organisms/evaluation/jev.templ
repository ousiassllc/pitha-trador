package evaluation

import (
	"fmt"

	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// jevBlock is Jev's hit rate and Brier score per label version, followed by
// the same metrics sliced by decision day, week, direction and grading
// horizon.
templ jevBlock(rows []JevRow, tables []JevTable) {
	<div class="mt-6 overflow-x-auto" data-testid="evaluation-jev">
		<h3 class="mb-3 text-item font-semibold text-ink">
			Jevの方向的中率とBrier
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation-jev", Label: "Jevの方向的中率とBrierの説明"}) {
				ラベル版ごとの集計です。方向的中率は予測の向きが実際の値動きと一致した割合（変わらずは除く）、Brier は予測した確率と結果のずれを表すスコアで、小さいほど良い値です。
			}
		</h3>
		if len(rows) == 0 {
			<p class="mt-1 text-note text-mute">ラベル付き判断はありません。</p>
		} else {
			<table class="mt-3 min-w-full text-item">
				<caption class="sr-only">Jevの方向的中率とBrier</caption>
				<thead>
					<tr class="text-right text-mute">
						<th scope="col" class="px-2 py-1.5 text-left text-note font-normal">ラベル</th>
						<th scope="col" class="px-2 py-1.5 text-right text-note font-normal">件数</th>
						<th scope="col" class="px-2 py-1.5 text-right text-note font-normal">方向的中率</th>
						<th scope="col" class="px-2 py-1.5 text-right text-note font-normal">Brier</th>
					</tr>
				</thead>
				<tbody>
					for i, r := range rows {
						<tr class="border-b border-line-soft last:border-b-0">
							<th scope="row" class="px-2 py-1.5 text-left font-normal text-ink">{ r.Label }</th>
							<td class="px-2 py-1.5 text-right font-mono tabular-nums">{ fmt.Sprintf("%d", r.N) }</td>
							@cell(r.HitRate, fmt.Sprintf("jev-%d-hit-rate", i))
							@cell(r.Brier, fmt.Sprintf("jev-%d-brier", i))
						</tr>
					}
				</tbody>
			</table>
		}
		for _, t := range tables {
			@jevTable(t)
		}
	</div>
}

templ jevTable(t JevTable) {
	<div class="mt-6 overflow-x-auto" data-testid={ "evaluation-jev-" + t.ID }>
		<h4 class="mb-3 text-item font-semibold text-ink">{ t.Title }</h4>
		<table class="mt-3 min-w-full text-item">
			<caption class="sr-only">Jevの方向的中率とBrier（{ t.Title }）</caption>
			<thead>
				<tr class="text-right text-mute">
					<th scope="col" class="px-2 py-1.5 text-left text-note font-normal">ラベル版</th>
					<th scope="col" class="px-2 py-1.5 text-left text-note font-normal">{ t.KeyHeader }</th>
					<th scope="col" class="px-2 py-1.5 text-right text-note font-normal">件数</th>
					<th scope="col" class="px-2 py-1.5 text-right text-note font-normal">方向的中率</th>
					<th scope="col" class="px-2 py-1.5 text-right text-note font-normal">Brier</th>
				</tr>
			</thead>
			<tbody>
				for i, r := range t.Rows {
					<tr class="border-b border-line-soft last:border-b-0" data-key={ r.Label + " " + r.Key }>
						<th scope="row" class="px-2 py-1.5 text-left font-normal text-ink">{ r.Label }</th>
						<td class="px-2 py-1.5 text-left font-mono tabular-nums">{ r.Key }</td>
						<td class="px-2 py-1.5 text-right font-mono tabular-nums">{ fmt.Sprintf("%d", r.N) }</td>
						@cell(r.HitRate, fmt.Sprintf("jev-%s-%d-hit-rate", t.ID, i))
						@cell(r.Brier, fmt.Sprintf("jev-%s-%d-brier", t.ID, i))
					</tr>
				}
			</tbody>
		</table>
	</div>
}

