package evaluation

import (
	"fmt"

	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// EvaluationPanel is the 実績評価 section of the Performance page: "is it
// winning?" as a 合格ライン verdict (an input to the pre-Live checks only;
// nothing gates on it) and the figures behind it. err replaces the content
// when the evaluation could not be read.
templ EvaluationPanel(p Panel, err string) {
	<section class="mt-8" aria-labelledby="evaluation-heading" data-testid="evaluation-panel">
		<h2 id="evaluation-heading" class="text-lg font-semibold text-slate-900">
			実績評価（勝てているか）
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation", Label: "実績評価の説明"}) {
				損益は手数料控除後の実現損益（円）です。[ ] は95%信頼区間で、同じ日の取引は相関するため日単位でまとめて評価しています。サンプルが基準未満の指標は「判定不能」と表示します。EV は1取引あたりの平均損益、PF はプロフィットファクター（総利益 ÷ 総損失）、最大DD は損益の累計がピークから最も下がった幅です。
			}
		</h2>
		if err != "" {
			<p class="mt-4 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert" data-testid="evaluation-error">{ err }</p>
		} else {
			<p class="mt-1 text-xs text-slate-500" data-testid="evaluation-capital">
				{ p.Capital }
				if p.CapitalNote != "" {
					（{ p.CapitalNote }）
				}
				@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation-capital", Label: "初期資金の説明"}) {
					Paper の初期資金は仮置きの値で、口座残高ではありません。資金比の最大ドローダウンの基準になります。設定キー: initial_capital
				}
			</p>
			@verdictBlock(p)
			@costBlock(p)
			@evalTable(Table{ID: "overall", Title: "全期間", KeyHeader: "区分", Rows: []Row{p.Overall}})
			for _, t := range p.Tables {
				@evalTable(t)
			}
			@jevBlock(p.Jev)
			@metaBlock(p.Meta)
		}
	</section>
}

func verdictClass(status string) string {
	switch status {
	case "pass":
		return "border-green-300 bg-green-50 text-green-900"
	case "fail":
		return "border-red-300 bg-red-50 text-red-900"
	}
	return "border-amber-300 bg-amber-50 text-amber-900"
}

templ verdictBlock(p Panel) {
	<div class={ "mt-4 rounded-md border px-4 py-3 text-sm " + verdictClass(p.Verdict) } data-testid="evaluation-verdict" data-status={ p.Verdict }>
		<p class="font-semibold">
			合格ライン: { p.VerdictText }
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation-verdict", Label: "合格ラインの説明"}) {
				<span class="block">{ p.Criteria }</span>
				<span class="mt-1 block">Live前チェックの材料であり、判定結果で Live が許可・拒否されることはありません。</span>
			}
		</p>
		<ul class="mt-2 list-inside list-disc">
			for _, c := range p.Checks {
				<li data-testid={ "evaluation-check-" + c.ID } data-status={ c.Status }>{ c.Label }: 実績 { c.Actual } / 基準 { c.Required } → { c.StatusText }</li>
			}
		</ul>
	</div>
}

templ costBlock(p Panel) {
	<dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3" data-testid="evaluation-costs">
		for _, c := range p.Costs {
			<div>
				<dt class="text-sm text-slate-500">
					{ c.Label }
					if c.Help != "" {
						@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation-cost-" + c.ID, Label: c.Label + "の説明"}) {
							{ c.Help }
						}
					}
				</dt>
				<dd class="text-sm font-medium text-slate-900">{ c.Value }</dd>
			</div>
		}
	</dl>
}

// cell renders one metric; id is the unique suffix of its help mark's id. A
// metric with a Help text (a 判定不能 one: the reference value and why)
// carries a help mark beside its text.
templ cell(c Cell, id string) {
	<td class={ "px-2 py-1 text-right " + cellClass(c) } data-undetermined?={ c.Undetermined }>
		{ c.Text }
		if c.Help != "" {
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation-" + id, Label: "判定の補足"}) {
				{ c.Help }
			}
		}
	</td>
}

func cellClass(c Cell) string {
	if c.Undetermined {
		return "text-slate-400"
	}
	return "text-slate-900"
}

templ evalTable(t Table) {
	<div class="mt-6 overflow-x-auto" data-testid={ "evaluation-table-" + t.ID }>
		<h3 class="text-sm font-semibold text-slate-700">{ t.Title }</h3>
		<table class="mt-1 min-w-full text-xs">
			<caption class="sr-only">{ t.Title }の実績指標</caption>
			<thead>
				<tr class="text-right text-slate-500">
					<th scope="col" class="px-2 py-1 text-left">{ t.KeyHeader }</th>
					<th scope="col" class="px-2 py-1">件数</th>
					<th scope="col" class="px-2 py-1">損益(円)</th>
					<th scope="col" class="px-2 py-1">勝率</th>
					<th scope="col" class="px-2 py-1">EV(円/取引)</th>
					<th scope="col" class="px-2 py-1">EV(bps/取引)</th>
					<th scope="col" class="px-2 py-1">PF</th>
					<th scope="col" class="px-2 py-1">最大DD(円)</th>
					<th scope="col" class="px-2 py-1">最大DD(資金比)</th>
				</tr>
			</thead>
			<tbody>
				for i, r := range t.Rows {
					<tr class="border-t border-slate-200" data-key={ r.Key }>
						<th scope="row" class="px-2 py-1 text-left font-medium text-slate-900">{ r.Key }</th>
						<td class="px-2 py-1 text-right">{ fmt.Sprintf("%d", r.N) }</td>
						<td class="px-2 py-1 text-right">{ r.NetPnL }</td>
						@cell(r.WinRate, fmt.Sprintf("%s-%d-win-rate", t.ID, i))
						@cell(r.EVJPY, fmt.Sprintf("%s-%d-ev-jpy", t.ID, i))
						@cell(r.EVBps, fmt.Sprintf("%s-%d-ev-bps", t.ID, i))
						@cell(r.ProfitFactor, fmt.Sprintf("%s-%d-pf", t.ID, i))
						@cell(r.DDJPY, fmt.Sprintf("%s-%d-dd-jpy", t.ID, i))
						@cell(r.DDPct, fmt.Sprintf("%s-%d-dd-pct", t.ID, i))
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ jevBlock(rows []JevRow) {
	<div class="mt-6 overflow-x-auto" data-testid="evaluation-jev">
		<h3 class="text-sm font-semibold text-slate-700">
			Jevの方向的中率とBrier
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation-jev", Label: "Jevの方向的中率とBrierの説明"}) {
				ラベル版ごとの集計です。方向的中率は予測の向きが実際の値動きと一致した割合（変わらずは除く）、Brier は予測した確率と結果のずれを表すスコアで、小さいほど良い値です。
			}
		</h3>
		if len(rows) == 0 {
			<p class="mt-1 text-xs text-slate-500">ラベル付き判断はありません。</p>
		} else {
			<table class="mt-1 min-w-full text-xs">
				<caption class="sr-only">Jevの方向的中率とBrier</caption>
				<thead>
					<tr class="text-right text-slate-500">
						<th scope="col" class="px-2 py-1 text-left">ラベル</th>
						<th scope="col" class="px-2 py-1">件数</th>
						<th scope="col" class="px-2 py-1">方向的中率</th>
						<th scope="col" class="px-2 py-1">Brier</th>
					</tr>
				</thead>
				<tbody>
					for i, r := range rows {
						<tr class="border-t border-slate-200">
							<th scope="row" class="px-2 py-1 text-left font-medium text-slate-900">{ r.Label }</th>
							<td class="px-2 py-1 text-right">{ fmt.Sprintf("%d", r.N) }</td>
							@cell(r.HitRate, fmt.Sprintf("jev-%d-hit-rate", i))
							@cell(r.Brier, fmt.Sprintf("jev-%d-brier", i))
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ metaBlock(rows []MetaRow) {
	<div class="mt-6 overflow-x-auto" data-testid="evaluation-meta">
		<h3 class="text-sm font-semibold text-slate-700">
			メタモデルのOOS指標とPaper実績EV
			@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-evaluation-meta", Label: "メタモデルのOOS指標とPaper実績EVの説明"}) {
				OOS（学習に使っていない期間）の指標と、同じ取引・同じ期間の Paper 実績 EV を並べて比べる表です。差は 実現EV − 予測EV です。
			}
		</h3>
		if len(rows) == 0 {
			<p class="mt-1 text-xs text-slate-500">学習済みのメタモデルはありません。</p>
		} else {
			<table class="mt-1 min-w-full text-xs">
				<caption class="sr-only">メタモデルのOOS指標とPaper実績EV</caption>
				<thead>
					<tr class="text-right text-slate-500">
						<th scope="col" class="px-2 py-1 text-left">版</th>
						<th scope="col" class="px-2 py-1">状態</th>
						<th scope="col" class="px-2 py-1">OOS期間</th>
						<th scope="col" class="px-2 py-1">OOS件数</th>
						<th scope="col" class="px-2 py-1">OOS AUC</th>
						<th scope="col" class="px-2 py-1">OOS EV(bps)</th>
						<th scope="col" class="px-2 py-1">採用取引 n</th>
						<th scope="col" class="px-2 py-1">予測EV(bps)</th>
						<th scope="col" class="px-2 py-1">実現EV(bps)</th>
						<th scope="col" class="px-2 py-1">差(実現−予測)</th>
						<th scope="col" class="px-2 py-1">OOS期間内の全取引 n</th>
						<th scope="col" class="px-2 py-1">同期間のPaper EV(bps)</th>
					</tr>
				</thead>
				<tbody>
					for i, r := range rows {
						<tr class="border-t border-slate-200" data-key={ r.Version }>
							<th scope="row" class="px-2 py-1 text-left font-medium text-slate-900">{ r.Version }</th>
							<td class="px-2 py-1 text-right">{ r.Status }</td>
							<td class="px-2 py-1 text-right">{ r.OOSWindow }</td>
							<td class="px-2 py-1 text-right">{ r.OOSSamples }</td>
							@cell(r.OOSAUC, fmt.Sprintf("meta-%d-oos-auc", i))
							@cell(r.OOSEV, fmt.Sprintf("meta-%d-oos-ev", i))
							<td class="px-2 py-1 text-right">{ fmt.Sprintf("%d", r.LinkedN) }</td>
							@cell(r.PredictedEV, fmt.Sprintf("meta-%d-predicted-ev", i))
							@cell(r.RealizedEV, fmt.Sprintf("meta-%d-realized-ev", i))
							@cell(r.EVGap, fmt.Sprintf("meta-%d-ev-gap", i))
							<td class="px-2 py-1 text-right">{ fmt.Sprintf("%d", r.WindowN) }</td>
							@cell(r.WindowEV, fmt.Sprintf("meta-%d-window-ev", i))
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}
