package organisms

import (
	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
)

// PositionPanel is Symbol Detail's "Position" panel: the symbol's open
// position as a one-row table, or a notice when position is nil.
templ PositionPanel(position *domain.Position) {
	<section class="mb-12 rounded-card bg-surface p-card" id="position-panel" data-testid="position-panel">
		<h2 class="mb-4 text-item font-semibold text-ink">ポジション</h2>
		if position == nil {
			<p class="rounded-card bg-surface-sel px-6 py-12 text-center text-note text-mute-on-soft">保有中のポジションはありません。</p>
		} else {
			<table class="w-full border-collapse text-left text-item" aria-label="ポジション">
				<thead>
					<tr>
						<th scope="col" class="px-3 py-2.5 text-note font-normal uppercase text-mute">銘柄</th>
						<th scope="col" class="px-3 py-2.5 text-note font-normal uppercase text-mute">売買</th>
						<th scope="col" class="px-3 py-2.5 text-right text-note font-normal uppercase text-mute">数量</th>
						<th scope="col" class="px-3 py-2.5 text-right text-note font-normal uppercase text-mute">建値</th>
						<th scope="col" class="px-3 py-2.5 text-right text-note font-normal uppercase text-mute">現在値</th>
						<th scope="col" class="px-3 py-2.5 text-right text-note font-normal uppercase text-mute">評価損益</th>
						<th scope="col" class="px-3 py-2.5 text-right text-note font-normal uppercase text-mute">実現損益</th>
						<th scope="col" class="px-3 py-2.5 text-note font-normal uppercase text-mute">建玉日時</th>
						<th scope="col" class="px-3 py-2.5 text-note font-normal uppercase text-mute">決済日時</th>
						<th scope="col" class="px-3 py-2.5 text-note font-normal uppercase text-mute">
							決済理由・操作
							@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-position-close", Label: "決済の説明"}) {
								Close は成行で決済します。昼休み・大引け後などの立会時間外は約定しないので決済できません。次の立会で再度お試しください。
							}
						</th>
					</tr>
				</thead>
				<tbody>
					@molecules.PositionRow(*position)
				</tbody>
			</table>
		}
	</section>
}
