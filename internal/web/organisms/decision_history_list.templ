package organisms

import (
	"fmt"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// DecisionHistoryList renders a symbol's Jev Scout/Trader decision
// history, most recent first (docs/components/overview.md §3
// "DecisionHistoryList（Jev判断履歴の時系列リスト）", functional.md §5.2
// Symbol Detail "Decision history"). Regime/EntryQuality are shown only
// for Trader decisions (Scout decisions leave them nil - see
// internal/service/execution.EnrichDecision's doc comment on why a
// caller must enrich a repository-read domain.JevDecision before it has
// these fields).
templ DecisionHistoryList(decisions []domain.JevDecision) {
	<section class="mt-8" id="decision-history" data-testid="decision-history">
		<h2 class="text-lg font-semibold text-slate-900">Decision history</h2>
		<table class="mt-4 w-full border-collapse text-left text-sm">
			<thead>
				<tr class="border-b border-slate-200 text-xs font-semibold uppercase text-slate-500">
					<th class="px-3 py-2">Time</th>
					<th class="px-3 py-2">Type</th>
					<th class="px-3 py-2">Direction</th>
					<th class="px-3 py-2">Confidence</th>
					<th class="px-3 py-2">Regime</th>
					<th class="px-3 py-2">Entry Quality</th>
				</tr>
			</thead>
			<tbody>
				for _, d := range decisions {
					@decisionRow(d)
				}
			</tbody>
		</table>
	</section>
}

templ decisionRow(d domain.JevDecision) {
	<tr class="border-b border-slate-100" data-decision-id={ fmt.Sprintf("%d", d.ID) }>
		<td class="px-3 py-2">{ atoms.FormatJST(d.Timestamp) }</td>
		<td class="px-3 py-2">{ d.DecisionType }</td>
		<td class="px-3 py-2">{ nilableString(d.Direction) }</td>
		<td class="px-3 py-2">{ nilableFloatStr(d.Confidence) }</td>
		<td class="px-3 py-2">{ nilableString(d.Regime) }</td>
		<td class="px-3 py-2">{ nilableString(d.EntryQuality) }</td>
	</tr>
}

func nilableString(s *string) string {
	if s == nil {
		return "—"
	}
	return *s
}

func nilableFloatStr(f *float64) string {
	if f == nil {
		return "—"
	}
	return fmt.Sprintf("%.2f", *f)
}
