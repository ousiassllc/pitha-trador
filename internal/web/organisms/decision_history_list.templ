package organisms

import (
	"fmt"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// DecisionHistoryList renders a symbol's Jev Scout/Trader decision
// history, most recent first (docs/components/overview.md §3
// "DecisionHistoryList（Jev判断履歴の時系列リスト）", functional.md §5.2
// Symbol Detail "Decision history"). Regime/EntryQuality are shown only
// for Trader decisions (Scout decisions leave them nil - see
// internal/service/execution.EnrichDecision's doc comment on why a
// caller must enrich a repository-read domain.JevDecision before it has
// these fields).
templ DecisionHistoryList(decisions []domain.JevDecision) {
	<section class="mt-12" id="decision-history" data-testid="decision-history">
		<h2 class="text-2xl font-semibold text-ink">判断の履歴</h2>
		<table class="mt-6 w-full border-collapse text-left text-sm" aria-label="Jev判断履歴">
			<thead>
				<tr class="border-b border-border text-xs font-semibold uppercase text-mute">
					<th scope="col" class="px-3 py-2.5">日時</th>
					<th scope="col" class="px-3 py-2.5">種別</th>
					<th scope="col" class="px-3 py-2.5">方向</th>
					<th scope="col" class="px-3 py-2.5 text-right">確信度</th>
					<th scope="col" class="px-3 py-2.5">相場状態</th>
					<th scope="col" class="px-3 py-2.5">エントリー品質</th>
				</tr>
			</thead>
			<tbody>
				for _, d := range decisions {
					@decisionRow(d)
				}
			</tbody>
		</table>
	</section>
}

templ decisionRow(d domain.JevDecision) {
	<tr class="border-b border-border" data-decision-id={ fmt.Sprintf("%d", d.ID) }>
		<td class="px-3 py-2.5">{ atoms.FormatJST(d.Timestamp) }</td>
		<td class="px-3 py-2.5">{ d.DecisionType }</td>
		<td class="px-3 py-2.5">{ nilableString(d.Direction) }</td>
		<td class="px-3 py-2.5 text-right font-mono tabular-nums">{ nilableFloatStr(d.Confidence) }</td>
		<td class="px-3 py-2.5">{ nilableString(d.Regime) }</td>
		<td class="px-3 py-2.5">{ nilableString(d.EntryQuality) }</td>
	</tr>
}

func nilableString(s *string) string {
	if s == nil {
		return "—"
	}
	return *s
}

func nilableFloatStr(f *float64) string {
	if f == nil {
		return "—"
	}
	return fmt.Sprintf("%.2f", *f)
}
