package organisms

import (
	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/version"
)

// Header is the global navigation + system-state indicator rendered on
// every page (docs/components/overview.md §3 "Header（ナビゲーション＋
// StatusDot。Kill Switch状態のOOB更新対象）"). HATEOAS (issue #106): the
// caller (layout.Shell, from middleware.SystemStateFrom) passes the live
// domain.SystemState, and Header SSRs `#header-status` and
// `pitha-kill-switch-panel` from it - the panel's `status`, which of
// `can-pause`/`can-resume`/`can-kill` are set (domain.SystemState.
// CanPause/CanResume/CanKill, the server-side transition rules), and every
// URL it calls (KillSwitchPanel). state "" means unknown (state not
// readable): Header then renders no StatusDot/action buttons and
// `#header-status` self-corrects via `hx-trigger="load"` calling the
// already-live `GET /system/status`, while the panel fetches
// `GET /api/v1/system/status` on its own connectedCallback.
//
// `#header-status`'s `hx-trigger` also listens for `systemStateChanged`
// bubbling from the enclosing `<header>` element (components/overview.md
// §5.4's `HeaderWithKillSwitch` pattern, matched here via `from:closest
// header` - there is exactly one `<header>` per page, so no dedicated
// hook class is needed; components/overview.md §1's Tailwind-utility-
// first styling means `class` here only carries layout/appearance
// utilities): `pitha-kill-switch-panel` dispatches that event after
// every successful `/api/v1/system/*` call, keeping this StatusDot in
// sync with actions Lit itself performed.
//
// `#config-banner` follows the exact same self-correcting pattern for
// issue #57's Settings feature: it SSRs empty (Header only knows the
// system state, so it cannot know secrets-table state at render time
// either) and immediately calls `GET /system/secrets-status`
// (internal/web/handler/settings.SettingsHandler.Status), which renders
// organisms.SecretsBanner listing any still-unset required key
// (JEV_API_KEY/JEV_BASE_URL/KABU_API_PASSWORD) with a link to
// `/settings`, or nothing once every one is configured.
//
// `#update-banner` is the same pattern for issue #76's update
// notification: `GET /system/update-status`
// (internal/web/handler/system.UpdateHandler.Status) renders organisms.UpdateBanner when a newer
// release exists (also re-polled every 60s, and immediately on the
// `updateStatusChanged` event the manual check response fires), or
// nothing otherwise - including on cmd/server, which has no updater.
//
// `#header-version` shows the running build's internal/version.Version on
// every page and links to Settings' アップデート section (`/settings#update-
// panel`), where the version is detailed and the manual update check
// lives. The check button itself is deliberately not in the header: a
// verified installer found by a check restarts the app, so it stays on a
// single, explicit Settings screen.
//
// `#header-logo` (issue #238) is the app logo (`/static/img/logo.svg`,
// go:embed'ed from static/src/img, same "P" mark as the desktop icon
// cmd/desktop/build/appicon.png) plus the app name, leading the nav in
// one flex group so the `justify-between` spacing of the version /
// StatusDot / Kill Switch items is unchanged. The `<img>` has an empty
// alt since the adjacent text already names the app.
//
// headerStatusTrigger is `#header-status`'s hx-trigger: an unknown state
// (see Header) additionally fetches the badge on `load`.
func headerStatusTrigger(state domain.SystemState) string {
	const onChange = "systemStateChanged from:closest header"
	if state == "" {
		return "load, " + onChange
	}
	return onChange
}

templ Header(state domain.SystemState) {
	<header class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 bg-white px-6 py-4">
		<div class="flex min-w-0 flex-wrap items-center gap-x-6 gap-y-2">
			<a
				id="header-logo"
				class="flex shrink-0 items-center gap-2 text-sm font-semibold text-slate-900"
				href="/scanner"
				data-testid="header-logo"
			>
				<img class="h-8 w-8" src="/static/img/logo.svg" width="32" height="32" alt=""/>
				<span>Pitha Trador</span>
			</a>
			<nav aria-label="メインナビゲーション" class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-slate-600">
				<a class="hover:text-slate-900" href="/scanner">Scanner</a>
				<a class="hover:text-slate-900" href="/performance">Performance</a>
				<a class="hover:text-slate-900" href="/calibration">Calibration</a>
				<a class="hover:text-slate-900" href="/activity">Activity</a>
				<a class="hover:text-slate-900" href="/settings">Settings</a>
			</nav>
		</div>
		<div
			id="config-banner"
			hx-get="/system/secrets-status"
			hx-trigger="load"
			hx-target="this"
			hx-swap="innerHTML"
		></div>
		<div
			id="update-banner"
			class="order-last w-full empty:hidden"
			hx-get="/system/update-status"
			hx-trigger="load, every 60s, updateStatusChanged from:body"
			hx-target="this"
			hx-swap="innerHTML"
		></div>
		<a
			id="header-version"
			class="text-xs text-slate-500 hover:text-slate-900"
			href="/settings#update-panel"
			title="アップデートの確認（設定）"
			data-testid="header-version"
		>{ version.Version }</a>
		<div
			id="header-status"
			class="flex items-center gap-3"
			hx-get="/system/status"
			hx-headers='{"X-Pitha-Background":"1"}'
			hx-trigger={ headerStatusTrigger(state) }
			hx-target="this"
			hx-swap="innerHTML"
		>
			if state != "" {
				@SystemStatusBadge(state)
			}
		</div>
		@KillSwitchPanel(state)
	</header>
}
