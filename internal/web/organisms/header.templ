package organisms

import (
	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/version"
)

// Header is the global navigation + system-state indicator rendered on
// every page (docs/components/overview.md §3 "Header（ナビゲーション＋
// StatusDot。Kill Switch状態のOOB更新対象）"). HATEOAS (issue #106): the
// caller (layout.Shell, from middleware.SystemStateFrom) passes the live
// domain.SystemState, and Header SSRs `#header-status` and
// `pitha-kill-switch-panel` from it - the panel's `status`, which of
// `can-pause`/`can-resume`/`can-kill` are set (domain.SystemState.
// CanPause/CanResume/CanKill, the server-side transition rules), and every
// URL it calls (KillSwitchPanel). state "" means unknown (state not
// readable): Header then renders no StatusDot/action buttons and
// `#header-status` self-corrects via `hx-trigger="load"` calling the
// already-live `GET /system/status`, while the panel fetches
// `GET /api/v1/system/status` on its own connectedCallback.
//
// `#header-status`'s `hx-trigger` also listens for `systemStateChanged`
// (components/overview.md §5.4's `HeaderWithKillSwitch` pattern): the event
// `pitha-kill-switch-panel` dispatches after every successful
// `/api/v1/system/*` call bubbles (and is composed) up to `body`, so the
// StatusDot follows actions Lit itself performed wherever the panel sits -
// here in the header, on the Home screen inside the 取引の状態 card
// (components/overview.md §1's Tailwind-utility-first styling means `class`
// here only carries layout/appearance utilities).
//
// `#attention-badge` (issue #896) replaces the five banners that used to stack
// under the header on every page (the unset optional keys, the update notice,
// the broker connection error, the daily entry halt and the market-data health
// alerts): it fetches `GET /home/attention-badge` (internal/web/handler/home),
// which renders organisms.AttentionBadge - 「要対応 N 件」 linking to the Home
// screen, where each of those conditions is listed in full with where to look -
// or nothing while there is none. It re-polls every 30s and immediately on
// `secretsStatusChanged` (Settings' Save/Delete, issue #695) and
// `updateStatusChanged` (the manual update check, issue #76). The Home screen
// shows the full list itself, so it renders no badge there (current is
// NavHome), and the Kill Switch panel moves into its 取引の状態 card.
//
// `#header-version` shows the running build's internal/version.Version on
// every page and links to Settings' アップデート section
// (`/settings/maintenance#update-panel`), where the version is detailed and
// the manual update check lives. The check button itself is deliberately not in the header: a
// verified installer found by a check restarts the app, so it stays on a
// single, explicit Settings screen.
//
// `#header-logo` (issue #238) is the app logo (`/static/img/logo.svg`,
// embedded from static/src/img, same "P" mark as the desktop icon
// cmd/desktop/build/appicon.png) plus the app name, leading the nav in
// one flex group so the `justify-between` spacing of the version /
// StatusDot / Kill Switch items is unchanged. The `<img>` has an empty
// alt since the adjacent text already names the app.
//
// current is the page's main-navigation entry (layout.Shell passes it
// through): MainNav marks that link `aria-current="page"` (issue #631).
//
// The polled `#attention-badge` container is the fixed live region
// (`role="status"` `aria-live="polite"`), so the badge carries no role of its
// own (a `role="alert"` body would be re-inserted and re-announced on every
// poll, issue #626); `data-live-banner` makes pitha-htmx-errors skip a swap
// whose markup is identical to what is already shown, so only a new/changed
// badge is announced. `empty:hidden` takes no space while there is none.
templ Header(state domain.SystemState, current NavItem) {
	<header class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 bg-white px-6 py-4">
		<div class="flex min-w-0 flex-wrap items-center gap-x-6 gap-y-2">
			<a
				id="header-logo"
				class="flex shrink-0 items-center gap-2 text-sm font-semibold text-slate-900"
				href="/"
				data-testid="header-logo"
			>
				<img class="h-8 w-8" src="/static/img/logo.svg" width="32" height="32" alt=""/>
				<span>Pitha Trador</span>
			</a>
			@MainNav(current)
		</div>
		if current != NavHome {
			<div
				id="attention-badge"
				class="empty:hidden"
				role="status"
				aria-live="polite"
				data-live-banner
				hx-get={ AttentionBadgeURL }
				hx-headers='{"X-Pitha-Background":"1"}'
				hx-trigger="load, every 30s, secretsStatusChanged from:body, updateStatusChanged from:body"
				hx-target="this"
				hx-swap="innerHTML"
			></div>
		}
		<a
			id="header-version"
			class="text-xs text-slate-500 hover:text-slate-900"
			href="/settings/maintenance#update-panel"
			title="アップデートの確認（設定）"
			data-testid="header-version"
		>{ version.Version }</a>
		<div
			id="header-status"
			class="flex items-center gap-3"
			hx-get="/system/status"
			hx-headers='{"X-Pitha-Background":"1"}'
			hx-trigger={ headerStatusTrigger(state) }
			hx-target="this"
			hx-swap="innerHTML"
		>
			if state != "" {
				@SystemStatusBadge(state)
			}
		</div>
		if current != NavHome {
			@KillSwitchPanel(state)
		}
	</header>
}

// headerStatusTrigger is `#header-status`'s hx-trigger: an unknown state
// (see Header) additionally fetches the badge on `load`.
func headerStatusTrigger(state domain.SystemState) string {
	const onChange = "systemStateChanged from:body"
	if state == "" {
		return "load, " + onChange
	}
	return onChange
}
