package organisms

import (
	"fmt"
	"time"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
)

// ScannerTableFallback renders the Scanner Dashboard's candidate table
// (functional.md §5.1, components/overview.md §3): Symbol, Price, 1m/5m
// Return, Volume Ratio, VWAP distance, Spread, Jev Direction/Confidence/
// Entry Quality, and Current Position. It is used both for the initial
// SSR page load and for the `GET /scanner` HX-Request fragment response
// (internal/web/handler.ScannerHandler.Page).
//
// The table is nested inside a `<pitha-scanner-table>` custom element
// (static/src/components/scanner-table): before JS loads (or for the
// no-JS case) browsers render an unknown element as a plain container, so
// this exact markup already displays correctly; once `pitha-scanner-table`
// upgrades, it renders into its own light DOM and takes over in place
// (sorting, `/ws/scanner` live updates), per its "銘柄行は通常の
// `<a href>` として描画する" contract (components/overview.md §5.2).
templ ScannerTableFallback(candidates []domain.Candidate, asOf time.Time) {
	<section class="mt-6" id="scanner-table" data-testid="scanner-table">
		<pitha-scanner-table api-url="/api/v1/scanner" ws-url="/ws/scanner">
			<table class="w-full border-collapse text-left text-sm">
				<caption class="mb-2 text-left text-sm text-slate-500">{ "Scanner Dashboard — as of " + asOf.Format(time.RFC3339) }</caption>
				<thead>
					<tr class="border-b border-slate-200 text-xs font-semibold uppercase text-slate-500">
						<th class="px-3 py-2">Symbol</th>
						<th class="px-3 py-2">Price</th>
						<th class="px-3 py-2">1m Return</th>
						<th class="px-3 py-2">5m Return</th>
						<th class="px-3 py-2">Volume Ratio</th>
						<th class="px-3 py-2">VWAP Distance (bps)</th>
						<th class="px-3 py-2">Spread (bps)</th>
						<th class="px-3 py-2">Jev</th>
						<th class="px-3 py-2">Position</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range candidates {
						@scannerRow(c)
					}
				</tbody>
			</table>
		</pitha-scanner-table>
	</section>
}

templ scannerRow(c domain.Candidate) {
	<tr class="border-b border-slate-100" data-symbol={ c.Symbol }>
		<td class="px-3 py-2 font-medium text-slate-900">{ c.Symbol }</td>
		<td class="px-3 py-2">{ formatFloat(c.Price, 1) }</td>
		<td class="px-3 py-2">{ formatNilFloat(c.Return1m, 2) }</td>
		<td class="px-3 py-2">{ formatNilFloat(c.Return5m, 2) }</td>
		<td class="px-3 py-2">{ formatNilFloat(c.VolumeRatio5m, 2) }</td>
		<td class="px-3 py-2">{ formatFloat(c.PriceVsVWAPBps, 0) }</td>
		<td class="px-3 py-2">{ formatNilFloat(c.SpreadBps, 0) }</td>
		<td class="px-3 py-2">
			@molecules.SignalBadgeGroup(c.JevDirection, c.JevConfidence, c.EntryQuality)
		</td>
		<td class="px-3 py-2">{ formatNilFloat(c.CurrentPosition, 0) }</td>
	</tr>
}

func formatFloat(v float64, decimals int) string {
	return fmt.Sprintf("%.*f", decimals, v)
}

func formatNilFloat(v *float64, decimals int) string {
	if v == nil {
		return "—"
	}
	return fmt.Sprintf("%.*f", decimals, *v)
}
