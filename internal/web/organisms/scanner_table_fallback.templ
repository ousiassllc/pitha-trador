package organisms

import (
	"math"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// ScannerTableFallback renders the Scanner Dashboard's candidate list
// (functional.md §5.1, components/overview.md §3): a candidate count, then
// a table of Symbol, Price, 1m/5m Return, Volume Ratio, VWAP distance,
// Spread, Jev Direction / Confidence / Entry Quality, and Current
// Position, or an empty-state notice when there are no candidates. It is
// rendered inside the `GET /scanner` full page
// (internal/web/pages.ScannerPage) as the SSR content `pitha-scanner-table`
// hydrates over.
//
// The markup is nested inside a `<pitha-scanner-table>` custom element
// (static/src/components/scanner-table): before JS loads (or for the
// no-JS case) browsers render an unknown element as a plain container, so
// this exact markup already displays correctly; once `pitha-scanner-table`
// upgrades, it renders into its own light DOM and takes over in place
// (sorting, `/ws/scanner` live updates), per its "銘柄行は通常の
// `<a href>` として描画する" contract (components/overview.md §5.2).
//
// Column labels/hints, number formats, sign coloring and badge colors are
// mirrored by that Lit component's render(); keep the two in sync so the
// hydrated view does not differ from the SSR one (issue #239).
templ ScannerTableFallback(candidates []domain.Candidate, asOf time.Time) {
	<section class="mt-6" id="scanner-table" data-testid="scanner-table">
		<pitha-scanner-table api-url="/api/v1/scanner" ws-url="/ws/scanner">
			<p class="mb-3 text-sm text-slate-600" data-testid="scanner-count">
				候補
				<span class="text-lg font-semibold text-slate-900">{ strconv.Itoa(len(candidates)) }</span>
				件
			</p>
			<details class="mb-3 text-sm text-slate-600" data-testid="scanner-column-help">
				<summary class="cursor-pointer select-none text-xs font-medium text-slate-700">列の意味</summary>
				<dl class="mt-2 grid gap-x-4 gap-y-1 text-xs sm:grid-cols-[max-content_1fr]">
					for _, col := range scannerColumns {
						<dt class="font-medium text-slate-700">{ col.Label }</dt>
						<dd>{ col.Hint }</dd>
					}
				</dl>
			</details>
			<div class="overflow-x-auto rounded-md border border-slate-200 bg-white">
				<table class="w-full border-collapse text-left text-sm">
					<caption class="border-b border-slate-200 px-3 py-2 text-left text-xs text-slate-500">{ "Scanner Dashboard — as of " + asOf.Format(time.RFC3339) }</caption>
					<thead>
						<tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
							for _, col := range scannerColumns {
								<th scope="col" class={ "whitespace-nowrap px-3 py-2", templ.KV("text-right", col.Numeric) } title={ col.Hint }>{ col.Label }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, c := range candidates {
							@scannerRow(c)
						}
					</tbody>
				</table>
			</div>
			if len(candidates) == 0 {
				<p class="mt-3 rounded-md border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500" data-testid="scanner-empty">
					現在、条件を満たす候補銘柄はありません。候補は15〜30秒ごとに更新され、見つかり次第ここに表示されます。
				</p>
			}
		</pitha-scanner-table>
	</section>
}

// scannerColumn is one column header: its Japanese label, the tooltip
// (`title`) explaining what the column means, and whether the column
// holds numbers (right-aligned).
type scannerColumn struct {
	Label   string
	Hint    string
	Numeric bool
}

// scannerColumns must stay in the same order/wording as COLUMNS in
// static/src/components/scanner-table/pitha-scanner-table.ts.
var scannerColumns = []scannerColumn{
	{"銘柄", "銘柄コード。行のコードをクリックすると銘柄詳細へ移動します", false},
	{"現在値", "直近の価格", true},
	{"1分騰落率(%)", "直近1分間の騰落率。プラス(緑)は上昇、マイナス(赤)は下落", true},
	{"5分騰落率(%)", "直近5分間の騰落率。プラス(緑)は上昇、マイナス(赤)は下落", true},
	{"出来高倍率", "直近5分の出来高が平常時の何倍か。大きいほど売買が活発", true},
	{"VWAP乖離(bps)", "現在値とVWAP(出来高加重平均価格)の差。1bps=0.01%。プラスはVWAPより高い", true},
	{"スプレッド(bps)", "売り気配と買い気配の差。1bps=0.01%。小さいほど売買コストが低い", true},
	{"Jev方向", "Jev Traderの判定方向。LONG=買い、SHORT=売り、NONE=見送り、pending=判定待ち", false},
	{"確信度", "Jev判定の確信度。高いほど判定に自信がある", true},
	{"エントリー品質", "エントリー好適度。poor < fair < good < strong < exceptional の順に良い", false},
	{"保有", "現在の保有ポジション(株数)。未保有は—", true},
}

templ scannerRow(c domain.Candidate) {
	<tr class="border-b border-slate-100 last:border-b-0 hover:bg-slate-50" data-symbol={ c.Symbol }>
		<td class="px-3 py-2 font-medium">
			<a class="text-sky-700 underline-offset-2 hover:underline" href={ SymbolHref(c.Symbol) }>{ c.Symbol }</a>
		</td>
		<td class="px-3 py-2 text-right tabular-nums">{ formatFloat(c.Price, 1) }</td>
		<td class={ returnClass(c.Return1m) }>{ formatSignedNilFloat(domain.RatioToPercentPtr(c.Return1m), 2) }</td>
		<td class={ returnClass(c.Return5m) }>{ formatSignedNilFloat(domain.RatioToPercentPtr(c.Return5m), 2) }</td>
		<td class="px-3 py-2 text-right tabular-nums">{ formatNilFloat(c.VolumeRatio5m, 2) }</td>
		<td class="px-3 py-2 text-right tabular-nums">{ formatSignedFloat(c.PriceVsVWAPBps, 0) }</td>
		<td class="px-3 py-2 text-right tabular-nums">{ formatNilFloat(c.SpreadBps, 0) }</td>
		<td class="px-3 py-2">
			if c.JevDirection == nil {
				<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500">pending</span>
			} else {
				@atoms.Badge(atoms.Direction(*c.JevDirection))
			}
		</td>
		<td class="px-3 py-2 text-right tabular-nums">{ formatConfidence(c.JevConfidence) }</td>
		<td class="px-3 py-2">
			if c.EntryQuality == nil {
				<span class="text-slate-400">—</span>
			} else {
				@atoms.EntryQualityBadge(*c.EntryQuality)
			}
		</td>
		<td class="px-3 py-2 text-right tabular-nums">{ formatNilFloat(c.CurrentPosition, 0) }</td>
	</tr>
}

// returnClass colors a return cell: green when positive, red when
// negative, neutral for zero or a missing value.
func returnClass(v *float64) string {
	const base = "px-3 py-2 text-right font-medium tabular-nums "
	switch {
	case v == nil || *v == 0:
		return base + "text-slate-500"
	case *v > 0:
		return base + "text-green-700"
	default:
		return base + "text-red-700"
	}
}

// formatFloat renders v with the given decimals like JavaScript's
// Number.prototype.toFixed in scanner-view.ts: exact decimal ties round
// away from zero (12.5 -> "13"), whereas fmt's %f rounds them to even
// (12.5 -> "12"). Non-tie values round identically in both. Zero is
// rendered without a sign.
func formatFloat(v float64, decimals int) string {
	if v == 0 {
		v = 0 // normalizes -0
	}
	// v*10^d is a half-integer (an exact tie) iff v*2^(d+1) is an odd
	// integer: v is dyadic, so the odd factor 5^d cannot change that.
	// Scaling by a power of two is exact.
	if scaled := math.Ldexp(v, decimals+1); scaled == math.Trunc(scaled) && math.Mod(scaled, 2) != 0 {
		v = math.Nextafter(v, math.Copysign(math.Inf(1), v)) // step past the tie, away from zero
	}
	return strconv.FormatFloat(v, 'f', decimals, 64)
}

func formatNilFloat(v *float64, decimals int) string {
	if v == nil {
		return "—"
	}
	return formatFloat(*v, decimals)
}

// formatSignedFloat is formatFloat with an explicit "+" for positive
// values (negative values already carry "-"). Zero carries no sign, like
// formatSigned in static/src/components/scanner-table/scanner-view.ts.
func formatSignedFloat(v float64, decimals int) string {
	if v > 0 {
		return "+" + formatFloat(v, decimals)
	}
	return formatFloat(v, decimals)
}

func formatSignedNilFloat(v *float64, decimals int) string {
	if v == nil {
		return "—"
	}
	return formatSignedFloat(*v, decimals)
}

// formatConfidence renders a 0..1 confidence as a whole percent, rounding
// half away from zero like Math.round in scanner-view.ts's formatConfidence
// (fmt's %.0f would round half to even).
func formatConfidence(v *float64) string {
	if v == nil {
		return "—"
	}
	return formatFloat(math.Round(*v*100), 0) + "%" // formatFloat drops the sign of -0, like `${-0}` in JS
}

// SymbolHref is the symbol detail link. It is the single source of the
// detail URL rule: the SSR rows use it directly and the scanner API /
// WebSocket items carry it as `detail_url` (handler.toScannerItems), so
// pitha-scanner-table never builds the URL itself (HATEOAS). Everything
// except RFC 3986 unreserved characters is percent-escaped
// (url.PathEscape alone would leave `&+:@=$`).
func SymbolHref(symbol string) templ.SafeURL {
	return templ.SafeURL("/symbols/" + strings.ReplaceAll(url.QueryEscape(symbol), "+", "%20"))
}
