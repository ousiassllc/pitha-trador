package organisms

import (
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/molecules"
)

// SettingGroupList is the operator-editable settings list of the Settings
// screen: one molecules.SettingsCard per group with its status
// badge, plus one molecules.Modal per group holding that group's
// molecules.SettingFieldRow forms. Every row keeps its own independent
// `POST`/`DELETE /ops-settings/:key` forms, so editing one field never
// touches another's stored value. The modals open through the `pitha-modal`
// script, which the hosting page must load.
templ SettingGroupList(groups []molecules.SettingGroupProps) {
	<ul class="flex flex-col gap-3" data-testid="setting-group-list">
		for _, group := range groups {
			@molecules.SettingsCard(molecules.SettingsCardProps{
				ID:          group.ID,
				ModalID:     group.ModalID(),
				Name:        group.Name,
				ActionLabel: "設定する",
				Status:      settingGroupCardStatus(group),
			})
		}
	</ul>
	for _, group := range groups {
		@molecules.Modal(group.ModalID(), group.Name) {
			if group.Note != "" {
				<div class="flex items-center gap-1 text-sm text-slate-600" data-testid={ group.ModalID() + "-note" }>
					反映のタイミングと注意事項
					@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-" + group.ID + "-note", Label: group.Name + "の反映のタイミングと注意事項"}) {
						{ group.Note }
					}
				</div>
			}
			if len(group.Derived) > 0 {
				@molecules.SettingGroupDerived(group, false)
			}
			for _, field := range group.Fields {
				@molecules.SettingFieldRow(field)
			}
		}
	}
}

// settingGroupCardStatus is the card's status slot: the group's explanation
// as a HelpMark next to the name, then the status badge. The badge keeps its
// own id (Save/Reset swap it out-of-band); the HelpMark sits outside it.
templ settingGroupCardStatus(group molecules.SettingGroupProps) {
	if group.Description != "" {
		@atoms.HelpMark(atoms.HelpMarkProps{ID: "help-" + group.ID + "-description", Label: group.Name + "の説明"}) {
			{ group.Description }
		}
	}
	@molecules.SettingGroupStatus(group, false)
}
