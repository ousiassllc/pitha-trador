package organisms

import (
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/domain"
)

// QueueStatusPanel renders each jobs queue's pending/running/recently
// failed counts (functional.md §4.15 FR-ACT-1, components/overview.md §3).
// System Activity Log embeds it inside `<pitha-activity-feed>`, which
// takes over the table in place and keeps it current from `/ws/activity`
// `job_update` messages (pages.ActivityLogPage).
templ QueueStatusPanel(queues []domain.QueueStatus) {
	<section class="mt-6" id="queue-status" data-testid="queue-status">
		<h2 class="mb-2 text-lg font-semibold text-slate-900">Job Queues</h2>
		<table class="w-full border-collapse text-left text-sm" aria-label="キュー状況">
			<thead>
				<tr class="border-b border-slate-200 text-xs font-semibold uppercase text-slate-500">
					<th scope="col" class="px-3 py-2">Queue</th>
					<th scope="col" class="px-3 py-2">Pending</th>
					<th scope="col" class="px-3 py-2">Running</th>
					<th scope="col" class="px-3 py-2">Failed (recent)</th>
				</tr>
			</thead>
			<tbody>
				for _, q := range queues {
					<tr class="border-b border-slate-100" data-queue={ q.Queue }>
						<td class="px-3 py-2 font-medium text-slate-900">{ q.Queue }</td>
						<td class="px-3 py-2">{ strconv.Itoa(q.Pending) }</td>
						<td class="px-3 py-2">{ strconv.Itoa(q.Running) }</td>
						<td class="px-3 py-2">{ strconv.Itoa(q.FailedRecent) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}
