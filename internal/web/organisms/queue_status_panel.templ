package organisms

import (
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/labels"
)

// QueueStatusPanel renders each jobs queue's pending/running/recently
// failed counts (functional.md §4.15 FR-ACT-1, components/overview.md §3).
// System Activity Log embeds it inside `<pitha-activity-feed>`, which
// takes over the table in place and keeps it current from `/ws/activity`
// `job_update` messages (pages.ActivityLogPage).
templ QueueStatusPanel(queues []domain.QueueStatus) {
	<section class="mt-12" id="queue-status" data-testid="queue-status">
		<h2 class="mb-6 text-xl font-semibold text-ink">ジョブの状況</h2>
		<table class="w-full border-collapse text-left text-sm" aria-label="キュー状況">
			<thead>
				<tr class="border-b border-border text-xs font-semibold uppercase text-mute">
					<th scope="col" class="px-3 py-2.5">キュー</th>
					<th scope="col" class="px-3 py-2.5 text-right">待機中</th>
					<th scope="col" class="px-3 py-2.5 text-right">実行中</th>
					<th scope="col" class="px-3 py-2.5 text-right">失敗（直近）</th>
				</tr>
			</thead>
			<tbody>
				for _, q := range queues {
					<tr class="border-b border-border" data-queue={ q.Queue }>
						<td class="px-3 py-2.5 text-ink">{ labels.JobQueue(q.Queue) }</td>
						<td class="px-3 py-2.5 text-right font-mono tabular-nums">{ strconv.Itoa(q.Pending) }</td>
						<td class="px-3 py-2.5 text-right font-mono tabular-nums">{ strconv.Itoa(q.Running) }</td>
						<td class="px-3 py-2.5 text-right font-mono tabular-nums">{ strconv.Itoa(q.FailedRecent) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}
