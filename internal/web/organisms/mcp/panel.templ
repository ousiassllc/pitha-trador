package mcp

import "github.com/ousiassllc/pitha-trador/internal/web/atoms"

// PanelProps is Panel's input (issue #792). The owning handler
// (internal/web/handler/mcpsettings) fills it from the MCP admin service,
// which never holds the API key: RevealedKey is the only field that ever
// carries one, and only on the response to the "generate / regenerate" action.
type PanelProps struct {
	Enabled bool
	Listen  string
	// State is "listening", "starting", "stopped", "error" or "no_key"; Note
	// explains it in operator-facing words (empty when there is nothing to
	// add).
	State string
	Note  string
	// KeyConfigured: a key is stored (its value is never shown again).
	KeyConfigured bool
	// URL and AuthHeader are what to register in the Grok Bot; AuthHeader
	// is always the masked form.
	URL        string
	AuthHeader string
	// ExePath/ExeExists: where the installer places paper-results-mcp.
	ExePath      string
	ExeExists    bool
	SettingsPath string
	// Warning is a settings file problem shown above the form (empty: none).
	Warning string
	// Notice is the outcome of the action that produced this fragment.
	Notice string
	// RevealedKey is the freshly generated key, shown once. Empty on every
	// other render, so a reload only ever shows the masked form.
	RevealedKey string
	// Managed: the application started the running process, so the screen
	// can stop it. External: the address answers but the application did not
	// start the process (the screen leaves it alone).
	Managed  bool
	External bool
	// AutoStart: the MCP starts with the application next time too;
	// AutoStartNote says so (or why not) in operator-facing words.
	AutoStart     bool
	AutoStartNote string
	// ConfigChanged: settings were saved after the process started; it runs
	// on the old ones until restarted.
	ConfigChanged bool
	// WriteGate shows the settings-write section (issue #806); false when
	// the application has no database behind it. WriteEnabled is the switch
	// (default on), Audit the newest audit rows.
	WriteGate    bool
	WriteEnabled bool
	Audit        []AuditRow
}

// Panel renders the Settings screen's MCP section (`#mcp-panel`'s content):
// the state (待受中 / 起動中 / 停止中 / エラー / キー未設定) and whether the MCP
// starts with the application next time, the 起動 / 停止 / 再起動 buttons
// (`POST /settings/mcp/{start,stop,restart}`, issue #795), the enable switch
// and listen address (saved by `POST /settings/mcp`), the API key generate /
// regenerate action (`POST /settings/mcp/key`), the values to register in the
// Grok Bot with the key masked, and where paper-results-mcp and its settings
// file live. The MCP is still a separate process: the application only
// launches it as a child, and a saved change takes effect on 再起動.
//
// The reveal block carries `hx-history="false"` (htmx must not snapshot the
// key into its history cache) and `autocomplete="off"`; its copy buttons are
// handled by static/src/components/copy-button.
templ Panel(props PanelProps) {
	<section class="flex flex-col gap-4 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-600" data-testid="mcp-panel" { pollAttrs(props)... }>
		<h3 class="sr-only">MCP</h3>
		<p>
			Grok Bot などから Paper の実績と Jev の判断を読み取り、許可されたときだけ基本設定（ホワイトリスト）を変更するための MCP エンドポイントです。MCP は本体とは別のプロセス（paper-results-mcp）で動き、既定ではオフ・API キーが未設定の間は待ち受けません。
		</p>
		if props.Notice != "" {
			<p class="text-emerald-700" role="status" data-testid="mcp-notice">{ props.Notice }</p>
		}
		if props.Warning != "" {
			<p class="text-amber-700" role="status" data-testid="mcp-warning">{ props.Warning }</p>
		}
		if props.RevealedKey != "" {
			@keyReveal(props.RevealedKey)
		}
		<div class="flex flex-col gap-1" data-testid="mcp-state" data-state={ props.State }>
			<span class="flex flex-wrap items-center gap-2 font-semibold text-slate-900">
				状態:
				@stateBadge(props.State)
			</span>
			if props.Note != "" {
				<span data-testid="mcp-state-note">{ props.Note }</span>
			}
			<span>待受アドレス: <code data-testid="mcp-listen">{ props.Listen }</code></span>
			<span data-testid="mcp-autostart" data-autostart={ boolAttr(props.AutoStart) }>{ props.AutoStartNote }</span>
			if props.ConfigChanged {
				<span class="text-amber-700" data-testid="mcp-config-changed">設定が保存されています。MCP は起動時の設定のまま動いているため、「再起動」を押すと反映されます。</span>
			}
		</div>
		@processControls(props)
		<form class="flex flex-col gap-3" hx-post="/settings/mcp" hx-target="#mcp-panel" hx-swap="innerHTML" hx-disabled-elt="find button" data-testid="mcp-form">
			<label class="flex items-center gap-2">
				@atoms.Input(atoms.InputProps{Name: "enabled", Type: "checkbox", Class: "h-4 w-4 flex-none", Attrs: enabledAttrs(props.Enabled)})
				<span class="font-medium text-slate-700">MCP を有効にする</span>
			</label>
			<label class="flex flex-col gap-1">
				<span class="font-medium text-slate-700">待受アドレス（ホスト:ポート）</span>
				@atoms.Input(atoms.InputProps{Name: "listen", Class: "bg-white px-3 py-2", Attrs: templ.Attributes{"value": props.Listen, "autocomplete": "off", "spellcheck": "false", "data-testid": "mcp-listen-input"}})
				<span class="text-xs text-slate-500">許可されるのは 127.0.0.1 / ::1（この PC 内のみ）と、この PC の tailnet アドレス（100.64.0.0/10・fd7a:115c:a1e0::/48）だけです。0.0.0.0・LAN・ホスト名は保存できません。空にすると 127.0.0.1:48110 になります。</span>
			</label>
			<div>
				@atoms.Button(atoms.ButtonProps{Type: "submit", Attrs: templ.Attributes{"data-testid": "mcp-save"}}) {
					保存
				}
			</div>
		</form>
		if props.WriteGate {
			@writeSection(props)
		}
		<div class="flex flex-col gap-2" data-testid="mcp-key">
			<span class="font-medium text-slate-700">
				API キー:
				if props.KeyConfigured {
					設定済み（画面には表示されません）
				} else {
					未設定
				}
			</span>
			<div>
				@atoms.Button(atoms.ButtonProps{Variant: keyButtonVariant(props.KeyConfigured), Attrs: keyButtonAttrs(props.KeyConfigured)}) {
					if props.KeyConfigured {
						API キーを再生成
					} else {
						API キーを生成
					}
				}
			</div>
			<span class="text-xs text-slate-500">生成したキーは生成直後に一度だけ表示されます。再生成すると古いキーは MCP を再起動した時点で使えなくなり、Grok Bot の登録も更新が必要です。</span>
		</div>
		<dl class="flex flex-col gap-2" data-testid="mcp-bot-values">
			<dt class="font-medium text-slate-700">Grok Bot に登録する値</dt>
			<dd class="flex flex-wrap items-center gap-2">
				URL: <code id="mcp-url" data-testid="mcp-url">{ props.URL }</code>
				@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Size: atoms.ButtonSmall, Attrs: templ.Attributes{"data-copy-from": "mcp-url", "data-testid": "mcp-copy-url"}}) {
					コピー
				}
			</dd>
			<dd>ヘッダー: <code data-testid="mcp-auth-header">{ props.AuthHeader }</code></dd>
		</dl>
		<dl class="flex flex-col gap-1" data-testid="mcp-locations">
			<dt class="font-medium text-slate-700">paper-results-mcp の配置先</dt>
			<dd class="flex flex-wrap items-center gap-2">
				<code data-testid="mcp-exe-path">{ props.ExePath }</code>
				if props.ExeExists {
					<span class="rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-800" data-testid="mcp-exe-found">見つかる</span>
				} else {
					<span class="rounded-full bg-yellow-100 px-2 py-1 text-xs font-medium text-yellow-800" data-testid="mcp-exe-missing">見つからない</span>
				}
			</dd>
			<dt class="font-medium text-slate-700">設定ファイルの場所</dt>
			<dd><code data-testid="mcp-settings-path">{ props.SettingsPath }</code></dd>
		</dl>
		<p class="text-xs text-slate-500" data-testid="mcp-restart-note">
			MCP は本体とは別のプロセスで、この画面の「起動」で本体の子プロセスとして起動されます（本体の DB 接続・書き込み権限は渡されず、API キーは起動引数・環境変数に載りません）。本体を終了すると MCP も止まります。有効・API キーあり・許可された待受アドレスのときは、本体の起動と同時に MCP も自動で起動します。設定を保存した後、反映するには「再起動」を押してください。
		</p>
	</section>
}

// keyReveal is the one-time display of a freshly generated key.
templ keyReveal(key string) {
	<div class="flex flex-col gap-2 rounded-md border border-amber-300 bg-amber-50 p-3" role="alert" hx-history="false" autocomplete="off" data-clear-on-close data-testid="mcp-key-reveal">
		<p class="font-semibold text-amber-900">新しい API キー（この表示は一度きりです。今すぐコピーしてください）</p>
		<div class="flex flex-wrap items-center gap-2">
			@atoms.Input(atoms.InputProps{ID: "mcp-new-key", Class: "bg-white px-3 py-2 font-mono", Attrs: templ.Attributes{"readonly": true, "value": key, "autocomplete": "off", "spellcheck": "false", "data-testid": "mcp-new-key"}})
			@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Size: atoms.ButtonSmall, Attrs: templ.Attributes{"data-copy-from": "mcp-new-key", "data-testid": "mcp-copy-key"}}) {
				キーをコピー
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			<code id="mcp-new-header" class="break-all" data-testid="mcp-new-header">Authorization: Bearer { key }</code>
			@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Size: atoms.ButtonSmall, Attrs: templ.Attributes{"data-copy-from": "mcp-new-header", "data-testid": "mcp-copy-header"}}) {
				ヘッダーをコピー
			}
		</div>
		<p class="text-xs text-amber-900">このキーは二度と表示されません。画面を閉じる・再読み込みすると伏せ字になります。紛失した場合は再生成してください。「再起動」を押すと新しいキーが有効になります。</p>
	</div>
}

templ stateBadge(state string) {
	switch state {
		case "starting":
			<span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-800">起動中</span>
		case "error":
			<span class="inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs font-semibold text-red-800">エラー</span>
		case "listening":
			<span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">待受中</span>
		case "no_key":
			<span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-1 text-xs font-semibold text-yellow-800">キー未設定</span>
		default:
			<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-600">停止中</span>
	}
}

// processControls: 起動 / 停止 / 再起動. Each is a POST (so it carries the
// session cookie and CSRF token like every state-changing request). 起動 is
// offered when nothing runs, 停止 only for a process the application started,
// 再起動 whenever the application owns the process or the last run failed.
templ processControls(props PanelProps) {
	<div class="flex flex-wrap items-center gap-2" data-testid="mcp-process-controls">
		@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonPrimary, Attrs: processAttrs("start", "mcp-start", props.Managed || props.External || props.State == "listening")}) {
			起動
		}
		@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Attrs: processAttrs("stop", "mcp-stop", !props.Managed)}) {
			停止
		}
		@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonSecondary, Attrs: processAttrs("restart", "mcp-restart", props.External && !props.Managed)}) {
			再起動
		}
	</div>
}

// pollAttrs makes a "starting" panel reload itself until the state settles
// (the swap replaces this element, so the polling ends with it). Other
// states never poll.
//
// A panel that shows the one-time API key never polls: the swap would erase
// the only display of the key.
func pollAttrs(props PanelProps) templ.Attributes {
	if props.State != "starting" || props.RevealedKey != "" {
		return nil
	}
	return templ.Attributes{"hx-get": "/settings/mcp-panel", "hx-trigger": "every 2s", "hx-target": "#mcp-panel", "hx-swap": "innerHTML"}
}

func processAttrs(action, testID string, disabled bool) templ.Attributes {
	attrs := templ.Attributes{
		"hx-post":         "/settings/mcp/" + action,
		"hx-target":       "#mcp-panel",
		"hx-swap":         "innerHTML",
		"hx-disabled-elt": "this",
		"data-testid":     testID,
	}
	if disabled {
		attrs["disabled"] = true
	}
	return attrs
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func enabledAttrs(enabled bool) templ.Attributes {
	attrs := templ.Attributes{"value": "on", "data-testid": "mcp-enabled"}
	if enabled {
		attrs["checked"] = true
	}
	return attrs
}

func keyButtonVariant(configured bool) atoms.ButtonVariant {
	if configured {
		return atoms.ButtonDangerOutline
	}
	return atoms.ButtonPrimary
}

// keyButtonAttrs: regenerating asks for confirmation, since it
// invalidates the key the Grok Bot already holds; the first generation has
// nothing to lose.
func keyButtonAttrs(configured bool) templ.Attributes {
	attrs := templ.Attributes{
		"hx-post":         "/settings/mcp/key",
		"hx-target":       "#mcp-panel",
		"hx-swap":         "innerHTML",
		"hx-disabled-elt": "this",
		"data-testid":     "mcp-generate-key",
	}
	if configured {
		attrs["hx-confirm"] = "API キーを再生成します。古いキーは使えなくなります（MCP の再起動後）。よろしいですか？"
	}
	return attrs
}
