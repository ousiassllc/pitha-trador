package organisms

import (
	"fmt"
	"math"
)

// PerformanceSummary is PerformanceSummaryPanel's plain-props view of one
// backtest metric set (internal/web/handler maps backtest.Metrics onto
// it), so organisms stay decoupled from internal/service. Return figures
// are percentage returns summed over trades. ProfitFactor is +Inf when
// there are wins and no losses.
type PerformanceSummary struct {
	TradeCount     int
	WinRate        float64
	AvgProfit      float64
	AvgLoss        float64
	ProfitFactor   float64
	Expectancy     float64
	MaxDrawdownPct float64
	GrossPnLPct    float64
	SlippagePnLPct float64
	FeePnLPct      float64
	NetPnLPct      float64
}

// PerformanceSummaryPanel renders one PerformanceSummary - FR-BT-1's
// trade count, win rate, average profit/loss, Profit Factor, Expectancy,
// Max Drawdown and gross/slippage/fee/net PnL (docs/components/
// overview.md §3 "PerformanceSummaryPanel").
templ PerformanceSummaryPanel(title string, m PerformanceSummary) {
	<section class="mb-6 rounded-lg border border-slate-200 bg-white p-6 shadow" data-testid="performance-summary">
		<h2 class="text-lg font-semibold text-slate-900">{ title }</h2>
		<dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
			@summaryMetric("取引数", "Trades", "trade_count", fmt.Sprintf("%d", m.TradeCount))
			@summaryMetric("勝率", "Win Rate", "win_rate", fmt.Sprintf("%.1f%%", m.WinRate*100))
			@summaryMetric("平均利益", "Avg Profit", "", pct(m.AvgProfit))
			@summaryMetric("平均損失", "Avg Loss", "", pct(m.AvgLoss))
			@summaryMetric("プロフィットファクター", "Profit Factor", "profit_factor", profitFactor(m.ProfitFactor))
			@summaryMetric("期待値", "Expectancy", "expectancy", pct(m.Expectancy))
			@summaryMetric("最大ドローダウン", "Max Drawdown", "max_drawdown_pct", pct(m.MaxDrawdownPct))
			@summaryMetric("総損益（コスト前）", "Gross PnL", "", pct(m.GrossPnLPct))
			@summaryMetric("損益（スリッページ）", "PnL (slippage)", "", pct(m.SlippagePnLPct))
			@summaryMetric("損益（手数料）", "PnL (fees)", "", pct(m.FeePnLPct))
			@summaryMetric("純損益", "Net PnL", "net_pnl_pct", pct(m.NetPnLPct))
		</dl>
	</section>
}

// summaryMetric is one labelled figure of PerformanceSummaryPanel; the English
// metric name stays in the title attribute (issue #895). key is the
// `data-metric` attribute, omitted when empty.
templ summaryMetric(label, title, key, value string) {
	<div>
		<dt class="text-sm text-slate-500" title={ title }>{ label }</dt>
		if key != "" {
			<dd class="text-sm font-medium text-slate-900" data-metric={ key }>{ value }</dd>
		} else {
			<dd class="text-sm font-medium text-slate-900">{ value }</dd>
		}
	</div>
}

func pct(v float64) string {
	return fmt.Sprintf("%.2f%%", v)
}

// profitFactor renders +Inf (wins with no losses, backtest.Aggregate's
// documented value) as "∞" instead of Go's "+Inf".
func profitFactor(v float64) string {
	if math.IsInf(v, 1) {
		return "∞"
	}
	return fmt.Sprintf("%.2f", v)
}
