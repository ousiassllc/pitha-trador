package organisms

import (
	"fmt"
	"math"
)

// PerformanceSummary is PerformanceSummaryPanel's plain-props view of one
// backtest metric set (internal/web/handler maps backtest.Metrics onto
// it), so organisms stay decoupled from internal/service. Return figures
// are percentage returns summed over trades. ProfitFactor is +Inf when
// there are wins and no losses.
type PerformanceSummary struct {
	TradeCount     int
	WinRate        float64
	AvgProfit      float64
	AvgLoss        float64
	ProfitFactor   float64
	Expectancy     float64
	MaxDrawdownPct float64
	GrossPnLPct    float64
	SlippagePnLPct float64
	FeePnLPct      float64
	NetPnLPct      float64
}

// PerformanceSummaryPanel renders one PerformanceSummary - FR-BT-1's
// trade count, win rate, average profit/loss, Profit Factor, Expectancy,
// Max Drawdown and gross/slippage/fee/net PnL (docs/components/
// overview.md §3 "PerformanceSummaryPanel").
templ PerformanceSummaryPanel(title string, m PerformanceSummary) {
	<section class="mb-6 rounded-lg border border-slate-200 bg-white p-6 shadow" data-testid="performance-summary">
		<h2 class="text-lg font-semibold text-slate-900">{ title }</h2>
		<dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
			<div>
				<dt class="text-sm text-slate-500">Trades</dt>
				<dd class="text-sm font-medium text-slate-900" data-metric="trade_count">{ fmt.Sprintf("%d", m.TradeCount) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Win Rate</dt>
				<dd class="text-sm font-medium text-slate-900" data-metric="win_rate">{ fmt.Sprintf("%.1f%%", m.WinRate*100) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Avg Profit</dt>
				<dd class="text-sm font-medium text-slate-900">{ pct(m.AvgProfit) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Avg Loss</dt>
				<dd class="text-sm font-medium text-slate-900">{ pct(m.AvgLoss) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Profit Factor</dt>
				<dd class="text-sm font-medium text-slate-900" data-metric="profit_factor">{ profitFactor(m.ProfitFactor) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Expectancy</dt>
				<dd class="text-sm font-medium text-slate-900" data-metric="expectancy">{ pct(m.Expectancy) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Max Drawdown</dt>
				<dd class="text-sm font-medium text-slate-900" data-metric="max_drawdown_pct">{ pct(m.MaxDrawdownPct) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Gross PnL</dt>
				<dd class="text-sm font-medium text-slate-900">{ pct(m.GrossPnLPct) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">PnL (slippage)</dt>
				<dd class="text-sm font-medium text-slate-900">{ pct(m.SlippagePnLPct) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">PnL (fees)</dt>
				<dd class="text-sm font-medium text-slate-900">{ pct(m.FeePnLPct) }</dd>
			</div>
			<div>
				<dt class="text-sm text-slate-500">Net PnL</dt>
				<dd class="text-sm font-medium text-slate-900" data-metric="net_pnl_pct">{ pct(m.NetPnLPct) }</dd>
			</div>
		</dl>
	</section>
}

func pct(v float64) string {
	return fmt.Sprintf("%.2f%%", v)
}

// profitFactor renders +Inf (wins with no losses, backtest.Aggregate's
// documented value) as "∞" instead of Go's "+Inf".
func profitFactor(v float64) string {
	if math.IsInf(v, 1) {
		return "∞"
	}
	return fmt.Sprintf("%.2f", v)
}
