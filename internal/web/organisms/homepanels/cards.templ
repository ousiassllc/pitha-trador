package homepanels

import (
	"strconv"

	"github.com/ousiassllc/pitha-trador/internal/web/organisms"
)

// The fragment URLs of the cards: `GET /home/<section>` re-renders one card's
// body (internal/web/handler/home).
const (
	TradeStatusURL = "/home/trade-status"
	PnLURL         = "/home/pnl"
	PositionsURL   = "/home/positions"
	AttentionURL   = "/home/attention"
	DetailsURL     = "/home/details"
)

// refreshHeaders marks the 30 s poll as a background request so it does not
// refresh the operator heartbeat (FR-RISK-6, middleware.Heartbeat).
const refreshHeaders = `{"X-Pitha-Background":"1"}`

const (
	cardClass       = "flex min-w-0 flex-col rounded-lg border border-slate-200 bg-white p-4 shadow-sm"
	cardTitleClass  = "text-sm font-semibold text-slate-600"
	cardErrorClass  = "mt-2 rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800"
	cardNoticeClass = "mt-2 text-xs text-amber-800"
	linkClass       = "text-sm font-semibold text-blue-700 underline"
)

// cardError is a card's own error line: its read failed, the rest of the
// screen is unaffected.
templ cardError(message string) {
	<p class={ cardErrorClass } role="alert" data-testid="home-card-error">{ message }</p>
}

// DestLink renders a 「どこを見るか」 link; nothing for the zero Link.
templ DestLink(l Link) {
	if l.Href != "" {
		<a class={ linkClass } href={ templ.SafeURL(l.Href) } data-testid="home-link">{ l.Label } →</a>
	}
}

// TradeStatusCard is the 取引の状態 card (issue #896 §5.1): whether new entries
// are allowed, the first reason when they are not, and the existing Kill Switch
// panel. The body is re-fetched every 30 s and right after the panel changes the
// state (`systemStateChanged`); the panel sits outside the swapped element, so
// its WebSocket and an open confirmation are never torn down by a refresh.
templ TradeStatusCard(v TradeStatusView) {
	<section class={ cardClass, "lg:col-span-4" } data-testid="home-trade-status-card" aria-labelledby="home-trade-status-title">
		<h2 id="home-trade-status-title" class={ cardTitleClass }>取引の状態</h2>
		<div
			id="home-trade-status"
			class="min-w-0"
			role="status"
			aria-live="polite"
			data-live-banner
			hx-get={ TradeStatusURL }
			hx-headers={ refreshHeaders }
			hx-trigger="every 30s, systemStateChanged from:body"
			hx-target="this"
			hx-swap="innerHTML"
		>
			@TradeStatusBody(v)
		</div>
		<div class="mt-auto pt-3" data-testid="home-kill-switch">
			@organisms.KillSwitchPanel(v.State)
		</div>
	</section>
}

// TradeStatusBody is the card's refreshed part.
templ TradeStatusBody(v TradeStatusView) {
	if v.Err != "" {
		@cardError(v.Err)
	} else {
		<p class="mt-2 flex items-start gap-2 text-base font-semibold leading-snug text-slate-900" data-testid="trade-status-sentence" data-allowed={ strconv.FormatBool(v.Allowed) }>
			<span aria-hidden="true" class={ "mt-1.5 inline-block h-2.5 w-2.5 shrink-0 rounded-full", templ.KV("bg-emerald-500", v.Allowed), templ.KV("bg-red-500", !v.Allowed) }></span>
			<span>{ v.Sentence }</span>
		</p>
		if v.Detail != "" {
			<p class="mt-1 text-xs leading-relaxed text-slate-600" data-testid="trade-status-detail">{ v.Detail }</p>
		}
		if v.Link.Href != "" {
			<p class="mt-1">@DestLink(v.Link)</p>
		}
		if v.Notice != "" {
			<p class={ cardNoticeClass } data-testid="trade-status-notice">{ v.Notice }</p>
		}
	}
}

// PnLCard is the 今日の Paper 損益 card: realized (closed since 00:00 JST) plus
// unrealized (open positions) and the day's counts.
templ PnLCard(v PnLView) {
	<section class={ cardClass, "lg:col-span-3" } data-testid="home-pnl-card" aria-labelledby="home-pnl-title">
		<h2 id="home-pnl-title" class={ cardTitleClass }>今日の Paper 損益</h2>
		<div
			id="home-pnl"
			class="min-w-0"
			hx-get={ PnLURL }
			hx-headers={ refreshHeaders }
			hx-trigger="every 30s"
			hx-target="this"
			hx-swap="innerHTML"
		>
			@PnLBody(v)
		</div>
	</section>
}

// PnLBody is the card's refreshed part.
templ PnLBody(v PnLView) {
	if v.Err != "" {
		@cardError(v.Err)
	} else {
		if v.UnrealizedKnown {
			<p class={ "mt-2 text-3xl font-bold tabular-nums", PnLClass(v.Total) } data-testid="pnl-total">{ FormatSignedYen(v.Total) }</p>
			<p class="text-xs text-slate-500">合計（実現＋含み）</p>
		} else {
			<p class="mt-2 text-sm text-slate-700" data-testid="pnl-total-unknown">合計は保有ポジションを読み取れないため表示できません。</p>
		}
		<dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
			<dt class="text-slate-600">実現損益</dt>
			<dd class={ "whitespace-nowrap text-right font-semibold tabular-nums", PnLClass(v.Realized) } data-testid="pnl-realized">{ FormatSignedYen(v.Realized) }<span class="ml-1 text-xs font-normal text-slate-500">（決済 { strconv.Itoa(v.ClosedCount) }件）</span></dd>
			<dt class="text-slate-600">含み損益</dt>
			if v.UnrealizedKnown {
				<dd class={ "whitespace-nowrap text-right font-semibold tabular-nums", PnLClass(v.Unrealized) } data-testid="pnl-unrealized">{ FormatSignedYen(v.Unrealized) }<span class="ml-1 text-xs font-normal text-slate-500">（保有中）</span></dd>
			} else {
				<dd class="text-right text-xs text-amber-800" data-testid="pnl-unrealized-unknown">読み取れませんでした</dd>
			}
			if v.OpenedKnown {
				<dt class="whitespace-nowrap text-slate-600">新規エントリー</dt>
				<dd class="text-right font-semibold tabular-nums" data-testid="pnl-opened">{ strconv.Itoa(v.OpenedCount) }件</dd>
			}
		</dl>
		if v.LossLimit != nil {
			<p class="mt-2 text-xs text-slate-500" data-testid="pnl-loss-limit">1日の損失上限（-{ FormatYen(v.LossLimit.LimitJPY) }）まで あと { FormatYen(v.LossLimit.RemainingJPY) }</p>
		}
	}
}

// PositionsCard is the 保有ポジション card: the open positions, each linking to
// its Symbol Detail page.
templ PositionsCard(v PositionsView) {
	<section class={ cardClass, "lg:col-span-5" } data-testid="home-positions-card" aria-labelledby="home-positions-title">
		<h2 id="home-positions-title" class={ cardTitleClass }>保有ポジション</h2>
		<div
			id="home-positions"
			class="min-w-0"
			hx-get={ PositionsURL }
			hx-headers={ refreshHeaders }
			hx-trigger="every 30s"
			hx-target="this"
			hx-swap="innerHTML"
		>
			@PositionsBody(v)
		</div>
	</section>
}

// PositionsBody is the card's refreshed part.
templ PositionsBody(v PositionsView) {
	if v.Err != "" {
		@cardError(v.Err)
	} else if len(v.Rows) == 0 {
		<p class="mt-3 rounded-md border border-dashed border-slate-300 bg-slate-50 px-3 py-6 text-center text-sm text-slate-500" data-testid="positions-empty">保有中のポジションはありません</p>
	} else {
		<p class="mt-1 text-2xl font-bold tabular-nums text-slate-900" data-testid="positions-count">{ strconv.Itoa(len(v.Rows)) }<span class="ml-1 text-sm font-normal text-slate-600">件</span></p>
		<div class="mt-2 max-h-44 overflow-y-auto">
			<table class="w-full border-collapse text-left text-xs" aria-label="保有ポジション" data-testid="positions-table">
				<thead>
					<tr class="border-b border-slate-200 text-slate-500">
						<th scope="col" class="py-1 pr-2 font-semibold">銘柄</th>
						<th scope="col" class="py-1 pr-2 font-semibold">売買</th>
						<th scope="col" class="py-1 pr-2 text-right font-semibold">数量</th>
						<th scope="col" class="py-1 pr-2 text-right font-semibold">取得価格</th>
						<th scope="col" class="py-1 pr-2 text-right font-semibold">現在値</th>
						<th scope="col" class="py-1 pr-2 text-right font-semibold">含み損益</th>
						<th scope="col" class="py-1 text-right font-semibold">保有時間</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range v.Rows {
						<tr class="border-b border-slate-100" data-testid="position-row">
							<td class="py-1 pr-2 font-semibold"><a class="text-blue-700 underline" href={ SymbolURL(r.Symbol) }>{ r.Symbol }</a></td>
							<td class="py-1 pr-2">{ SideLabel(r.Side) }</td>
							<td class="py-1 pr-2 text-right tabular-nums">{ strconv.FormatInt(r.Quantity, 10) }</td>
							<td class="py-1 pr-2 text-right tabular-nums">{ FormatPrice(r.EntryPrice) }</td>
							<td class="py-1 pr-2 text-right tabular-nums">{ FormatPrice(r.CurrentPrice) }</td>
							<td class={ "py-1 pr-2 text-right font-semibold tabular-nums", PnLClass(r.Unrealized) }>{ FormatSignedYen(r.Unrealized) }</td>
							<td class="whitespace-nowrap py-1 text-right tabular-nums">{ FormatHeld(r.Held) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
