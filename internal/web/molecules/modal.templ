package molecules

// Modal is a native `<dialog>` shell (issue #302): a title bar with a
// 「閉じる」 button above the children. It renders closed; the
// `pitha-modal` script (static/src/components/modal) opens it from a
// `[data-modal-open="<id>"]` button or a URL hash pointing inside it, and
// closes it on 「閉じる」, a backdrop click or Esc. `showModal()` supplies
// the focus containment, `aria-modal` semantics and Esc handling, so the
// markup only labels the dialog (`aria-labelledby`) and stays free of
// framework state - the children are plain HTMX forms/panels (light DOM).
// The dialog has no padding of its own so a click that lands on the dialog
// element itself is always a backdrop click.
templ Modal(id, title string) {
	<dialog
		id={ id }
		class="m-auto max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-lg border border-slate-200 bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/50"
		aria-labelledby={ id + "-title" }
		data-modal
		data-testid={ id }
	>
		<div class="flex items-center justify-between gap-4 border-b border-slate-200 px-5 py-3">
			<h2 id={ id + "-title" } class="text-lg font-semibold text-slate-900">{ title }</h2>
			<button class="rounded-md border border-slate-300 px-3 py-1 text-sm font-semibold text-slate-700" type="button" data-modal-close data-testid={ id + "-close" }>閉じる</button>
		</div>
		<div class="flex flex-col gap-4 px-5 py-4">
			{ children... }
		</div>
	</dialog>
}
