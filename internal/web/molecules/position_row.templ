package molecules

import (
	"fmt"
	"time"

	"github.com/ousiassllc/pitha-trador/internal/domain"
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
	"github.com/ousiassllc/pitha-trador/internal/web/labels"
)

// PositionRow renders one positions row (docs/components/overview.md §3
// "PositionRow"): symbol/side/quantity/entry-current price/P&L/opened-
// closed timestamps. It is used both for the Symbol Detail position list
// and as `POST /positions/:id/close`'s response fragment
// (docs/api/endpoints.md §4: "ポジション行フラグメント").
templ PositionRow(p domain.Position) {
	<tr class="border-b border-border" id={ fmt.Sprintf("position-row-%d", p.ID) } data-testid="position-row" data-position-id={ fmt.Sprintf("%d", p.ID) }>
		<td class="px-3 py-2 text-ink">{ p.Symbol }</td>
		<td class="px-3 py-2">@atoms.Badge(positionSideToDirection(p.Side))</td>
		<td class="px-3 py-2 text-right font-mono tabular-nums">{ fmt.Sprintf("%d", p.Quantity) }</td>
		<td class="px-3 py-2 text-right font-mono tabular-nums">{ fmt.Sprintf("%.2f", p.EntryPrice) }</td>
		<td class="px-3 py-2 text-right font-mono tabular-nums">{ fmt.Sprintf("%.2f", p.CurrentPrice) }</td>
		<td class="px-3 py-2 text-right font-mono tabular-nums">{ formatPnL(p.UnrealizedPnL) }</td>
		<td class="px-3 py-2 text-right font-mono tabular-nums">{ formatNilablePnL(p.RealizedPnL) }</td>
		<td class="px-3 py-2">{ atoms.FormatJST(p.OpenedAt) }</td>
		if p.IsOpen() {
			<td class="px-3 py-2">—</td>
			<td class="px-3 py-2">
				@atoms.Button(atoms.ButtonProps{Variant: atoms.ButtonDanger, Size: atoms.ButtonSmall, Attrs: templ.Attributes{
					"id":                    fmt.Sprintf("close-position-%d", p.ID),
					"data-focus-after-swap": fmt.Sprintf("position-row-%d", p.ID),
					"hx-post":               fmt.Sprintf("/positions/%d/close", p.ID),
					"hx-target":             fmt.Sprintf("#position-row-%d", p.ID),
					"hx-swap":               "outerHTML",
					"hx-disabled-elt":       "this",
					"hx-confirm":            "このポジションを成行で決済しますか？",
				}}) {
					Close
				}
			</td>
		} else {
			<td class="px-3 py-2">{ formatClosedAt(p.ClosedAt) }</td>
			<td class="px-3 py-2">{ formatExitReason(p.ExitReason) }</td>
		}
	</tr>
}

func positionSideToDirection(side string) atoms.Direction {
	if side == domain.PositionSideShort {
		return atoms.DirectionShort
	}
	return atoms.DirectionLong
}

func formatPnL(v float64) string {
	return fmt.Sprintf("%.2f", v)
}

func formatNilablePnL(v *float64) string {
	if v == nil {
		return "—"
	}
	return fmt.Sprintf("%.2f", *v)
}

func formatClosedAt(t *time.Time) string {
	if t == nil {
		return "—"
	}
	return atoms.FormatJST(*t)
}

func formatExitReason(r *string) string {
	if r == nil {
		return "—"
	}
	return labels.ExitReason(*r)
}
