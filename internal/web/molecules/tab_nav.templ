package molecules

// Tab is one entry of TabNav: a link to a page (or a view of a page) with
// the label shown on it.
type Tab struct {
	Label string
	Href  templ.SafeURL
	// Current marks the tab of the page being shown.
	Current bool
}

// tabLinkClass is a tab's styling: the current tab carries the underline.
func tabLinkClass(current bool) string {
	const base = "-mb-px inline-flex min-h-10 items-center border-b-2 px-3 text-base "
	if current {
		return base + "border-ink text-ink"
	}
	return base + "border-transparent text-mute hover:border-border hover:text-ink"
}

// TabNav renders the tab bar of a main-menu entry that spans several pages
// (候補銘柄: 候補・監視リスト, 成績: 実績・バックテスト・予測の精度; issue
// #895). Each tab is a plain link to its own URL, so a tab keeps working
// without JavaScript and the Header entry stays highlighted by the page's
// NavItem; the current tab carries `aria-current="page"`. label names the
// `<nav>` landmark for assistive technology.
templ TabNav(label string, tabs []Tab) {
	<nav aria-label={ label } class="mt-6 flex flex-wrap gap-2 border-b border-border print:hidden" data-testid="tab-nav">
		for _, t := range tabs {
			<a
				class={ tabLinkClass(t.Current) }
				href={ t.Href }
				if t.Current {
					aria-current="page"
				}
			>{ t.Label }</a>
		}
	</nav>
}
