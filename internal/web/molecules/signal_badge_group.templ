package molecules

import (
	"github.com/ousiassllc/pitha-trador/internal/web/atoms"
)

// SignalBadgeGroup renders the direction + confidence + entry_quality
// combination for one candidate (docs/components/overview.md §3). Any nil
// field means Jev Trader has not evaluated the candidate yet (a later
// sub-scope populates domain.Candidate's Jev* fields) - rendered as
// "pending" rather than a fabricated value.
templ SignalBadgeGroup(direction *string, confidence *float64, entryQuality *string) {
	if direction == nil {
		<span class="inline-flex items-center rounded-full border tone-mute px-2 py-1 text-xs text-mute">判定待ち</span>
	} else {
		<span class="inline-flex items-center gap-2">
			@atoms.Badge(toDirection(*direction))
			<span class="text-xs text-mute">{ atoms.FormatConfidence(confidence) }</span>
			<span class="text-xs text-ink">{ formatEntryQuality(entryQuality) }</span>
		</span>
	}
}

func toDirection(s string) atoms.Direction {
	switch atoms.Direction(s) {
	case atoms.DirectionLong:
		return atoms.DirectionLong
	case atoms.DirectionShort:
		return atoms.DirectionShort
	default:
		return atoms.DirectionNone
	}
}

func formatEntryQuality(v *string) string {
	if v == nil {
		return "—"
	}
	return *v
}
