package molecules

import "github.com/ousiassllc/pitha-trador/internal/web/middleware"

// SecretFieldRowProps is SecretFieldRow's input: Key is the secrets-table
// row key (config.Key*, also the `/settings/:key` path segment), Label the
// human-readable heading, Hint optional input guidance shown under the
// field (e.g. the expected URL format; empty for none), Configured
// whether a value is currently stored (the value itself is never
// re-displayed, issue #57's decision), and Notice the outcome message of
// the save/delete that just rendered this row (empty on the initial page
// load).
type SecretFieldRowProps struct {
	Key        string
	Label      string
	Hint       string
	Configured bool
	Notice     string
}

// SecretFieldRow is one Settings field with its own independent save and
// delete forms (issue #79): saving posts only this row's value to `POST
// /settings/:key` and deleting calls `DELETE /settings/:key`, each
// swapping this row alone, so no action can touch another key's value.
// The delete button is rendered only while a value is stored. The hidden
// `_csrf` field carries the CSRF token for the plain `method="post"`
// fallback (JS disabled), which cannot send the `X-CSRF-Token` header
// (middleware.CSRFFormField, issue #142).
templ SecretFieldRow(props SecretFieldRowProps) {
	<form
		class="flex flex-col gap-1 text-sm text-slate-600"
		method="post"
		action={ templ.SafeURL("/settings/" + props.Key) }
		hx-post={ "/settings/" + props.Key }
		hx-target="this"
		hx-swap="outerHTML"
		data-testid={ "secret-field-row-" + props.Key }
	>
		<input type="hidden" name={ middleware.CSRFFormField } value={ middleware.CSRFToken(ctx) }/>
		<label class="flex flex-col gap-1" for={ "secret-input-" + props.Key }>
			<span class="flex items-center gap-2">
				{ props.Label }
				if props.Configured {
					<span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600" data-testid={ "configured-" + props.Key }>(設定済み)</span>
				}
			</span>
		</label>
		<div class="flex items-center gap-2">
			<input
				id={ "secret-input-" + props.Key }
				class="flex-1 rounded-md border border-slate-300 px-3 py-1"
				type="password"
				name="value"
				required
				autocomplete="off"
				placeholder={ secretFieldPlaceholder(props.Configured) }
			/>
			<button class="rounded-md bg-blue-600 px-4 py-1 text-sm font-semibold text-white" type="submit" data-testid={ "save-" + props.Key }>保存</button>
			if props.Configured {
				<button
					class="rounded-md border border-red-300 px-4 py-1 text-sm font-semibold text-red-700"
					type="button"
					hx-delete={ "/settings/" + props.Key }
					hx-params="none"
					hx-confirm={ props.Label + " を削除しますか？" }
					data-testid={ "delete-" + props.Key }
				>削除</button>
			}
		</div>
		if props.Hint != "" {
			<p class="text-xs text-slate-500" data-testid={ "hint-" + props.Key }>{ props.Hint }</p>
		}
		if props.Notice != "" {
			<p class="text-xs text-green-800" role="status" data-testid={ "notice-" + props.Key }>{ props.Notice }</p>
		}
	</form>
}

// secretFieldPlaceholder hints at the field's current state without ever
// rendering the stored value itself.
func secretFieldPlaceholder(configured bool) string {
	if configured {
		return "変更する場合のみ入力"
	}
	return "未設定"
}
