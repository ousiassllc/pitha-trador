# pitha-trador environment variables (docs/environment/setup.md).
# This file is only a template listing the variables. The app does NOT
# load .env automatically: set the values you need as process environment
# variables (shell / OS). .env is gitignored.

# Gin listen address for cmd/server (the headless entrypoint,
# docs/architecture/overview.md §9). PITHA_SERVER_ADDR does not apply to
# cmd/desktop (the Wails desktop shell): its pages and API are served via
# the Wails AssetServer and it has no HTTP port. Only on Windows (WebView2)
# it additionally starts a WebSocket-only loopback listener (`/ws/...`
# Upgrade requests only; 127.0.0.1 and [::1] on the same random port, see
# cmd/desktop/ws_listener.go). cmd/server defaults to
# "127.0.0.1:48080" (chosen over the far more commonly-claimed 8080, and
# distinct from kabuステーションAPIの18080, docs/architecture/overview.md
# §5). A non-loopback address (e.g. ":48080") is rejected at startup
# unless PITHA_SERVER_ALLOW_NON_LOOPBACK=1 is also set.
PITHA_SERVER_ADDR=127.0.0.1:48080

# Set to "1" to let PITHA_SERVER_ADDR bind a non-loopback address
# (deliberate exposure only; cmd/server rejects it otherwise).
# PITHA_SERVER_ALLOW_NON_LOOPBACK=

# Extra Host header names (comma-separated hostnames, e.g. a LAN name) that
# cmd/server accepts. Only applies together with
# PITHA_SERVER_ALLOW_NON_LOOPBACK=1; loopback names and PITHA_SERVER_ADDR's
# own host (unless a wildcard) are always accepted.
# PITHA_SERVER_ALLOWED_HOSTS=

# Set to "true" to enable the /swagger API docs UI (Stoplight Elements,
# served from the vendored, same-origin /static/dist/vendor/ assets).
# Only that route is toggled; /api/v1/openapi.json is always served.
# Opt-in: disabled unless "true" (production must leave this off).
SWAGGER_ENABLED=false

# JEV_API_KEY/JEV_BASE_URL/JEV_MODEL (internal/service/jev.Config), KABU_API_PASSWORD
# (internal/service/marketdata.Config.APIPassword) and SLACK_WEBHOOK_URL
# (non-functional.md §5.2's immediate alerts), plus the optional
# LUNA_API_KEY/LUNA_BASE_URL/NEWS_FEED_URL/NEWS_FEED_API_KEY/NEWS_FEED_ENABLED
# (Luna news classification, architecture/overview.md §13) and
# SOL_API_KEY/SOL_BASE_URL/OPUS_API_KEY/OPUS_BASE_URL (self-improvement
# loop, §8) are no longer configured via
# `.env` (issue #57). Enter them from the running app's Settings screen
# (`/settings`) instead - they are stored encrypted in the `secrets`
# table (internal/repository/system.SecretsRepository) and take effect after an
# app restart. JEV_API_KEY/KABU_API_PASSWORD are required: while either is
# unset the Setup Guard redirects every page to `/setup`. The other keys are
# optional. Luna/Sol/Opus default to Jev (JEV_API_KEY alone is enough) and the
# news feed defaults to the yanoshin TDnet WebAPI (no key); the LUNA_*/SOL_*/
# OPUS_*/NEWS_FEED_* keys only override one role or the feed, and
# NEWS_FEED_ENABLED=off stops news ingest (issue #273).
#
# Jev (TypeSafe AI) values on the Settings screen:
#   JEV_API_KEY  = an API key issued at https://console.typesafe.ai (required)
#   JEV_BASE_URL = optional override in the Jev connection modal; empty means the
#                  default https://api.typesafe.ai (host only - no /v1/systemone path)
#   JEV_MODEL    = optional override in the Jev connection modal; empty means jev-latest

# Overrides internal/bootstrap's default SQLite DB file location
# (internal/bootstrap.DefaultDBPath: "%AppData%\pitha-trador\pitha.db" on
# Windows, "$XDG_CONFIG_HOME/pitha-trador/pitha.db" on Linux/macOS dev
# machines). Leave unset unless you need the DB file somewhere else
# (e.g. a portable/no-install deployment).
PITHA_DB_PATH=

# Directory shared by the daily JSON logs, their .gz archives and the
# error-log download (internal/bootstrap/startup.LogDir). Leave unset to use
# "logs" next to the SQLite DB file (never the working directory). If it
# cannot be created the app logs to stderr and keeps starting.
# PITHA_LOG_DIR=

# Destination directory of the daily SQLite backup (requirements/
# non-functional.md §3). Point it OUTSIDE the local application disk
# (external drive / synced cloud folder). Leave unset to disable the
# backup job (a warning is logged at start-up).
PITHA_BACKUP_DIR=

# Overrides the default config/strategy.yaml and config/risk.yaml locations.
# When unset, internal/bootstrap uses config/*.yaml in the same directory as
# the executable (only if the file exists), otherwise the embedded defaults.
# Set these only when an edited copy lives elsewhere.
# NOTE: an older strategy.yaml lacking scan.event_trigger.* keys (or with a
# value <= 0) gets the shipped default for that threshold at load time, with a
# warning; a 0 threshold would otherwise fire FR-SCAN-1 on every bar.
# The same applies to the scan.*_seconds interval keys (a missing/<= 0 value
# gets the shipped default; a *_max below its *_min is raised to the min; both
# with a warning): a 0 interval would spin the candidate refresh loop.
PITHA_STRATEGY_PATH=
PITHA_RISK_PATH=

# Universe CSV (instrument master) synced into `instruments` once at
# start-up (environment/setup.md "銘柄マスタの投入"). Precedence: this
# variable > config/universe.csv next to the executable. If neither exists
# the sync is skipped, and an empty instruments table logs an error because
# no instrument would be scanned. `make dev` points it at
# config/universe.sample.csv.
PITHA_UNIVERSE_PATH=

# Serve /static/... from this directory instead of the go:embed snapshot
# (dev-mode override; `make dev` sets it to static/src). Only an existing
# directory takes effect; otherwise the embedded assets are used.
# PITHA_STATIC_DIR=

# Policy Engine threshold overrides, applied on top of config/strategy.yaml's
# policy.long / policy.short sections at startup. A non-numeric value
# (MIN_ENTRY_QUALITY excepted: it is a string) fails startup. Leave unset
# to keep the YAML value.
# PITHA_POLICY_LONG_MIN_PROBABILITY=
# PITHA_POLICY_LONG_MIN_ENTRY_QUALITY=
# PITHA_POLICY_LONG_MIN_CONTINUATION_PROBABILITY=
# PITHA_POLICY_LONG_MAX_TOXIC_FLOW=
# PITHA_POLICY_LONG_MAX_LIQUIDITY_STRESSED=
# PITHA_POLICY_SHORT_MIN_PROBABILITY=
# PITHA_POLICY_SHORT_MIN_ENTRY_QUALITY=
# PITHA_POLICY_SHORT_MIN_CONTINUATION_PROBABILITY=
# PITHA_POLICY_SHORT_MAX_TOXIC_FLOW=
# PITHA_POLICY_SHORT_MAX_LIQUIDITY_STRESSED=

# Fast Screener filter/weight overrides (FR-FS-1/FR-FS-3). Each is applied
# on top of config/strategy.yaml's fast_screener section at startup; a
# runtime_settings "screener.*" DB value still takes precedence. Leave
# unset to keep the YAML value.
# PITHA_FAST_SCREENER_MIN_PRICE=
# PITHA_FAST_SCREENER_MAX_PRICE=
# PITHA_FAST_SCREENER_MIN_TURNOVER_5M_JPY=
# PITHA_FAST_SCREENER_MAX_SPREAD_BPS=
# PITHA_FAST_SCREENER_MIN_VOLUME_RATIO=
# PITHA_FAST_SCREENER_MIN_ABS_RETURN_5M_PCT=
# PITHA_FAST_SCREENER_MIN_REALIZED_VOLATILITY=
# PITHA_FAST_SCREENER_TOP_N=
# PITHA_FAST_SCREENER_WEIGHT_VOLUME_RATIO=
# PITHA_FAST_SCREENER_WEIGHT_ABS_RETURN_5M=
# PITHA_FAST_SCREENER_WEIGHT_BREAKOUT_STRENGTH=
# PITHA_FAST_SCREENER_WEIGHT_ORDERBOOK_IMBALANCE=
# PITHA_FAST_SCREENER_WEIGHT_VOLATILITY_EXPANSION=
